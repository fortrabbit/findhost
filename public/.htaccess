# Apache serves .md with no Content-Type at all, so the markdown twin of every
# page arrives untyped and a browser offers to download it.
AddType text/markdown .md
AddCharset UTF-8 .md

# Correct, and inert on fortrabbit today — MR-266. A miss serves the platform's
# own error page instead, and carries none of the headers or compression this
# file applies to every 200, so Apache is producing that 404 outside this
# directory's configuration and never reaches this line. Deploying an inline
# string in place of the path proved it: the string never appeared either.
# Kept because it is the right directive and costs nothing if that changes.
ErrorDocument 404 /404.html

# No HSTS on purpose: it is the one header here that cannot be taken back
# within its max-age. Referrer-Policy earns its place — every record links out
# to a provider, and the default hands each of them the full referring URL.
#
# Strict is the floor, not the whole rule. A record's own links opt back up to
# no-referrer-when-downgrade per link (src/lib/links.ts), so a provider clicking
# through sees which record sent them rather than only the domain. The header
# still covers everywhere else: "/regions/de/, then clicked out" is a lead
# signal, and an address that one day carries a token would carry it out too.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Nothing was cached either: every asset carried an ETag and no lifetime, so a
# reader moving between records revalidated the same stylesheet on every page.
# The hashed ones can be cached outright — a new build writes a new filename, so
# the URL cannot go stale — while HTML is left to revalidate, because a record
# corrected today has to be the record served today.
# Matched on the build hash in the name rather than on the extension, because
# /providers.json and pagefind-entry.json keep their URLs across builds and
# freezing either would serve a stale register and a search index that no longer
# matches it. Only a filename that changes when its contents do is cached here.
<IfModule mod_headers.c>
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Nothing was compressed: the homepage went out at 274 KB, and so did every
# markdown twin and the whole JSON and CSV export. Listed by type rather than by
# extension so pagefind's index chunks, which are compressed binaries already
# and carry no type, are left alone.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/markdown text/csv text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# Brotli where the module is there, gzip where it is not. Both filters on the
# same body would compress it twice, so the one that runs second is turned off
# for the requests the first will handle — inside the IfModule, because without
# mod_brotli every browser sends `br` anyway and this would leave the site
# uncompressed for all of them.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/markdown text/csv text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
  SetEnvIfNoCase Accept-Encoding br no-gzip
</IfModule>

# The surface is small enough to name in full: our own files, plus Fathom.
# `unsafe-inline` is unavoidable rather than lazy — the theme runs before first
# paint so it cannot be a request, the record figures carry their own colours as
# attributes, and the JSON-LD block differs on every page, so no fixed hash
# covers them. What the policy is actually for is the rest: no plugins, no
# framing, no form posting anywhere but here, and no base tag rewriting every
# relative link on the page.
#
# Fathom is in `img-src` as well as `script-src`, because it reports a
# pageview by loading an image rather than by fetching: without it the script
# still runs, the beacon is refused, and analytics go quietly to zero.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.usefathom.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.usefathom.com; font-src 'self'; connect-src 'self' https://cdn.usefathom.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
</IfModule>
