---
import { facetIndex, type Facet } from '../lib/facets';

interface Props {
  facet: Facet;
}

const { facet } = Astro.props;

/** Values in use, commonest first. The order is fixed here and never re-sorted. */
const values = facet.values
  .filter((value) => value.count > 0)
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, 'en'));

/** How many values show before the "more" button. */
const shown = 5;
const tail = values.slice(shown);

const missing = [
  facet.unknown > 0 && `${facet.unknown} unknown`,
  facet.notApplicable > 0 && `${facet.notApplicable} n/a`,
]
  .filter(Boolean)
  .join(' · ');
---

<div class="find-facet" role="group" aria-labelledby={`facet-${facet.id}`}>
  <h2 class="find-facet-title" id={`facet-${facet.id}`}>
    <a href={facetIndex(facet.id)}>{facet.label}</a>{' '}
    <a class="find-jump" href={facetIndex(facet.id)} aria-hidden="true" tabindex="-1">→</a>
  </h2>

  {
    values.slice(0, shown).map((value) => (
      <label title={value.label}>
        <input type="checkbox" data-facet={facet.id} value={value.id} autocomplete="off" />
        <span class="find-value">{value.short ?? value.label}</span>
        <span class="find-count">
          {value.count}
          <span class="visually-hidden"> records</span>
        </span>
      </label>
    ))
  }

  {
    tail.length > 0 && (
      <div class="find-tail" id={`tail-${facet.id}`} hidden>
        {tail.map((value) => (
          <label title={value.label}>
            <input type="checkbox" data-facet={facet.id} value={value.id} autocomplete="off" />
            <span class="find-value">{value.short ?? value.label}</span>
            <span class="find-count">
              {value.count}
              <span class="visually-hidden"> records</span>
            </span>
          </label>
        ))}
      </div>
    )
  }

  {
    /* One line under the list: what it is hiding, and what it never knew. A
      derived facet has neither, so it gets no line rather than an empty one. */
  }
  {
    (tail.length > 0 || missing) && (
      <p class="find-facet-foot">
        {[
          tail.length > 0 && (
            <button
              type="button"
              class="find-more"
              aria-expanded="false"
              aria-controls={`tail-${facet.id}`}
              data-more={tail.length}
            >
              {tail.length} more
            </button>
          ),
          missing,
        ]
          .filter(Boolean)
          .flatMap((part, index) => (index ? [' · ', part] : [part]))}
      </p>
    )
  }
</div>
