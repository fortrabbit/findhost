---
interface Row {
  id: string;
  name: string;
  description?: string;
  publishedByUs?: boolean;
  greenWebId?: number | null;
  /** ISO code, shown as text. A flag is a picture of a government, not of where a server is. */
  country?: string;
  figure?: { emoji: string; color: string; textColor: string };
  /** The FindHost Signal total, shown beside the country. Absent where the list is an index. */
  signal?: number;
}

interface Props {
  providers: Row[];
  /** Set where the list is an index rather than a register — the map's country sections, say. */
  namesOnly?: boolean;
}

const { providers, namesOnly = false } = Astro.props;
---

<ul class="provider-list">
  {
    providers.map((provider) => {
      const described = !namesOnly && Boolean(provider.description);

      return (
        <li class={described ? undefined : 'one-line'}>
          {/* A record without a figure gets its initial, so a gap never looks like a broken row. */}
          {provider.figure ? (
            <span
              class="provider-tile"
              style={`background:${provider.figure.color};color:${provider.figure.textColor}`}
              aria-hidden="true"
            >
              {provider.figure.emoji}
            </span>
          ) : (
            <span class="provider-tile letter" aria-hidden="true">
              {provider.name.slice(0, 1).toLowerCase()}
            </span>
          )}

          <div class="provider-body">
            <span class="provider-name">
              <a href={`/${provider.id}/`}>{provider.name}</a>
              {provider.greenWebId && (
                <span
                  class="green-mark"
                  title="Listed in the Green Web Foundation directory, which verifies the claim against published evidence"
                >
                  🌿<span class="visually-hidden"> Listed in the Green Web Foundation directory</span>
                </span>
              )}
              {provider.publishedByUs && <span class="self-marker">published by us</span>}
            </span>
            {described && <p>{provider.description}</p>}
          </div>

          {/* One column, however many facts are in it: the row is a grid, and a fourth child would wrap. */}
          <span class="provider-meta">
            {provider.country && <span class="provider-country">{provider.country}</span>}
            {provider.signal !== undefined && !namesOnly && (
              <a
                class="provider-signal"
                href="/signal/"
                title="FindHost Signal — our opinionated score, and how it is worked out"
              >
                {provider.signal}
              </a>
            )}
          </span>
        </li>
      );
    })
  }
</ul>
