---
import { logoOf, logoSize } from '../lib/logos';

interface Props {
  id: string;
  class?: string;
  /** Above the fold on a record page; lists leave it lazy. */
  eager?: boolean;
}

const { id, class: className, eager = false } = Astro.props;
const logo = logoOf(id);

/*
 * The tile is CSS, not part of the image: most logos are drawn for white, so
 * they sit on white in both themes, and the PNG stays transparent. The alt is
 * empty because the provider's name is always beside it.
 */
---

{
  logo && (
    <figure class:list={['provider-logo', className]}>
      <div class:list={['provider-logo-tile', { fills: logo.fills, light: logo.light }]}>
        <img src={logo.src} alt="" width={logoSize} height={logoSize} loading={eager ? 'eager' : 'lazy'} decoding="async" />
      </div>
    </figure>
  )
}
