---
import FindFacet from './FindFacet.astro';
import type { Facet } from '../lib/facets';

import type { ProviderRow } from '../lib/facets';

interface Props {
  facets: Facet[];
  providers: ProviderRow[];
}

const { facets, providers } = Astro.props;

/*
 * What the script needs to filter, and nothing else: which values each record
 * holds, and which fields it says do not apply. The names, descriptions and
 * figures are already on the page — find.ts hides rows rather than building
 * them — so shipping them again would be sending the register twice.
 *
 * Inline rather than fetched. It is a third of what /providers.json weighs, it
 * arrives with the markup it describes, and the filters work on first paint
 * instead of after a round trip. /providers.json stays what it is: the whole
 * dataset, published under CC BY, which is a different job from this one.
 */
const index = {
  facets: facets.map((facet) => ({
    id: facet.id,
    field: facet.field,
    values: facet.values.filter((value) => value.count > 0).map((value) => value.id),
  })),
  providers: providers.map((provider) => ({
    id: provider.id,
    facets: provider.facets,
    notApplicable: provider.notApplicable,
  })),
};

/*
 * The filter panel, as markup rather than as DOM built in a loop. find.ts used
 * to construct every element here, which put the whole design of the panel
 * inside a script nobody edits for design reasons.
 *
 * It ships visible, and it is the register's index: every value here is a real
 * link to that value's page, which is how a crawler finds 186 of them. Only the
 * checkboxes need the script, so only the checkboxes wait for it — see the `js`
 * class set before first paint in Base.astro. Hiding the whole panel until
 * hydration put those links in display:none and made the panel arrive with a
 * visible jump.
 *
 * Open by default: every facet shows, and the control is there to put them away
 * rather than to fetch them.
 */
---

<details class="find-panel" data-pagefind-ignore data-find-filters open>
  <summary>Filters</summary>

  <div class="find-filters full-width">
    {
      /* A facet no record answers yet is a column of nothing. It appears the
         moment the data does, without anyone remembering to add it. */
      facets
        .filter((facet) => facet.values.some((value) => value.count > 0))
        .map((facet) => <FindFacet facet={facet} />)
    }
  </div>

  <script type="application/json" data-find-index set:html={JSON.stringify(index)} is:inline />
</details>
