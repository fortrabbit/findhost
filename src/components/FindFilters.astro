---
import FindFacet from './FindFacet.astro';
import type { Facet } from '../lib/facets';

interface Props {
  facets: Facet[];
  /** How many hidden records exist. Zero means the stubs group is not offered at all. */
  drafts: number;
}

const { facets, drafts } = Astro.props;

/*
 * The filter panel, as markup rather than as DOM built in a loop. find.ts used
 * to construct every element here, which put the whole design of the panel
 * inside a script nobody edits for design reasons.
 *
 * It is hidden until the script takes it over, because a checkbox that filters
 * nothing is worse than no checkbox: without JavaScript the fallback below the
 * register links every value as a page instead.
 */
---

<div class="find-filters full-width" data-find-filters hidden>
  {facets.map((facet) => <FindFacet facet={facet} />)}

  {
    drafts > 0 && (
      <div class="find-facet find-drafts">
        <h2 class="find-facet-title">Stubs</h2>

        <label>
          {/* autocomplete=off on every box: the panel is static markup now, and a
              browser restoring a checked state on reload would disagree with the
              URL, which is the only state this script trusts. */}
          <input type="checkbox" data-drafts autocomplete="off" />
          <span class="find-value">Show these too</span>
          <span class="find-count">
            {drafts}
            <span class="visually-hidden"> records</span>
          </span>
        </label>

        <p class="annotation">Started and unfinished, or considered and out of scope. Not counted, not filtered.</p>
      </div>
    )
  }
</div>
