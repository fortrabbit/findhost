---
import FindFacet from './FindFacet.astro';
import type { Aside, Facet } from '../lib/facets';

interface Props {
  facets: Facet[];
  /** How many hidden records exist. Zero means the row is not offered at all. */
  drafts: number;
  /** The groups beside the register, one row each. Same rule: no row where there is nothing to show. */
  asides: Aside[];
}

const { facets, drafts, asides } = Astro.props;

/*
 * The filter panel, as markup rather than as DOM built in a loop. find.ts used
 * to construct every element here, which put the whole design of the panel
 * inside a script nobody edits for design reasons.
 *
 * It ships visible, and it is the register's index: every value here is a real
 * link to that value's page, which is how a crawler finds 186 of them. Only the
 * checkboxes need the script, so only the checkboxes wait for it — see the `js`
 * class set before first paint in Base.astro. Hiding the whole panel until
 * hydration put those links in display:none and made the panel arrive with a
 * visible jump.
 *
 * Open by default: every facet shows, and the control is there to put them away
 * rather than to fetch them.
 */
---

<details class="find-panel" data-pagefind-ignore data-find-filters open>
  <summary>Filters</summary>

  <div class="find-filters full-width">
    {
      /* A facet no record answers yet is a column of nothing. It appears the
         moment the data does, without anyone remembering to add it. */
      facets
        .filter((facet) => facet.values.some((value) => value.count > 0))
        .map((facet) => <FindFacet facet={facet} />)
    }

    {
      /*
       * Not filters. These are groups beside the register with pages of their
       * own, so they are links — a tick that appended a second list under the
       * first answered "show me these" with "here are those, and everything
       * else", and left the only way to them unlinkable.
       */
      (drafts > 0 || asides.length > 0) && (
        <div class="find-facet find-drafts">
          <h2 class="find-facet-title">
            <span>Other</span>
          </h2>

          <div class="find-values">
            {asides.map((aside) => (
              <div class="find-row">
                <a class="find-value" href={`/${aside.key}/`}>
                  {aside.label}
                </a>
                <a class="find-count" href={`/${aside.key}/`}>
                  {aside.rows.length}
                  <span class="visually-hidden"> records</span>
                </a>
              </div>
            ))}

            {drafts > 0 && (
              <div class="find-row">
                <a class="find-value" href="/stubs/">
                  Stubs
                </a>
                <a class="find-count" href="/stubs/">
                  {drafts}
                  <span class="visually-hidden"> records</span>
                </a>
              </div>
            )}
          </div>

          <p class="find-facet-foot">Not in the register and not in its count. Each keeps a page.</p>
        </div>
      )
    }

  </div>
</details>
