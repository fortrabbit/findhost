---
export type AiLevel = 'none' | 'grammar' | 'co-authored' | 'authored';

interface Props {
  ai?: AiLevel;
}

const { ai = 'grammar' } = Astro.props;

// Same four sentences fortrabbit.com uses, so both properties make the same claim in the same words.
const descriptions: Record<AiLevel, string> = {
  none: 'All mistakes 100% human. AI was not involved creating this.',
  grammar: 'Written by a human. Review, grammar checks and typo fixes by AI.',
  'co-authored': 'Written by humans and AI in collaboration.',
  authored: 'Written by AI, lectured by a human.',
};
---

<p role="note" aria-label="AI content disclosure">
  {descriptions[ai]}{' '}
  <a href="/about/#ai">How this site is made</a>.
</p>
