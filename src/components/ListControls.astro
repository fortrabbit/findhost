---
import ListStyleToggle from './ListStyleToggle.astro';

/**
 * What sits between a list and its heading. One control now — how much of each
 * row to show — after the Signal ordering was replaced by a heart on the rows
 * that earn one. A bar with nothing in it but the toggle is still worth keeping:
 * it is the rule that separates the list from whatever introduced it.
 */
---

<div class="list-controls">
  <ListStyleToggle />
</div>
