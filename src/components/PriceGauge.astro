---
import { bandIndex, priceBands, priceSentence, sliceHeight } from '../lib/price';

interface Props {
  from?: string;
  to?: string;
  /** sm in a list, md on a record, lg where the scale itself is the subject. */
  size?: 'sm' | 'md' | 'lg';
  /** Set on the large one, which is read rather than glanced at. */
  labelled?: boolean;
}

const { from, to, size = 'sm', labelled = false } = Astro.props;

const start = bandIndex(from);
const end = bandIndex(to) === -1 ? start : bandIndex(to);
const sentence = priceSentence(from, to);

/*
 * Boxes, not a drawing. An SVG scaled to a strip this small rendered its own
 * strokes at inconsistent widths — a hairline is a hairline, and no amount of
 * vector-effect makes a 1px stroke survive being squashed to nine pixels tall.
 *
 * Every band keeps its slot whether or not this provider covers it, so the
 * shape says where a provider sits on the scale and how much sits above. The
 * bands it covers are solid; the rest are a tick on the baseline, which reads
 * at any size and has no border to render badly.
 */
const bars = priceBands.map((band, index) => {
  const covered = start >= 0 && index >= start && index <= end;
  // Only a covered band gets a height; the rest take the tick height from CSS.
  return { band, covered, style: covered ? `height:${Math.round(sliceHeight(index) * 100)}%` : undefined };
});
---

{
  start >= 0 && (
    <span class:list={['price-gauge', `price-gauge-${size}`]}>
      <span class="price-gauge-bars" role="img" aria-label={sentence}>
        {bars.map((bar) => (
          <span class:list={['price-gauge-bar', bar.covered && 'is-covered']} style={bar.style} />
        ))}
      </span>

      {labelled && (
        <span class="price-gauge-scale" aria-hidden="true">
          {priceBands.map((band) => (
            <span>{band.short}</span>
          ))}
        </span>
      )}
    </span>
  )
}
