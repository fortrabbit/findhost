---
import { countryPoints, landPath, latLngToXY, spacing, viewBox } from '../lib/map';

interface Props {
  /** ISO country codes to mark. Repeats are counted, not deduplicated. */
  regions: string[];
  /** Countries carrying more records get a larger dot. */
  weighted?: boolean;
  /** Where a dot leads. `{code}` and `{lower}` are replaced — '#{lower}', '/regions/{code}/'. */
  linkPattern?: string;
  /** Let the map use the width of the screen rather than the reading column. */
  full?: boolean;
  /** Off where the map is a doorway rather than the subject — the home page sends you to /map/ for the detail. */
  caption?: boolean;
  label: string;
}

const { regions, weighted = false, linkPattern, full = false, caption = true, label } = Astro.props;

const counts = new Map<string, number>();
for (const code of regions) counts.set(code, (counts.get(code) ?? 0) + 1);

const highest = Math.max(1, ...counts.values());

const marks = [...counts.entries()]
  .filter(([code]) => countryPoints[code])
  .map(([code, count]) => {
    const point = countryPoints[code]!;
    const scale = weighted ? 0.6 + (count / highest) * 0.9 : 1;
    return {
      code,
      count,
      point,
      xy: latLngToXY(point.lat, point.lng),
      radius: spacing * 1.1 * scale,
      href: linkPattern?.replace('{code}', code).replace('{lower}', code.toLowerCase()),
    };
  })
  .sort((a, b) => a.code.localeCompare(b.code, 'en'));

const unplaced = [...counts.keys()].filter((code) => !countryPoints[code]);
---

<figure class:list={['world-map', full && 'full-width']}>
  <svg viewBox={viewBox} xmlns="http://www.w3.org/2000/svg" role="img" aria-label={label}>
    <path
      d={landPath}
      fill="none"
      stroke="currentColor"
      stroke-width={spacing * 0.7}
      stroke-linecap="round"
      stroke-dasharray={`0 ${spacing}`}
      opacity="0.35"></path>
    {
      marks.map((mark) => {
        const dot = (
          <>
            <title>
              {mark.point.label}
              {weighted && ` — ${mark.count} ${mark.count === 1 ? 'provider' : 'providers'}`}
            </title>
            {/* A dot is smaller than a finger, so the target is not the dot. */}
            <circle cx={mark.xy.x} cy={mark.xy.y} r={Math.max(mark.radius * 2.4, spacing * 2.4)} fill="transparent" />
            <circle cx={mark.xy.x} cy={mark.xy.y} r={mark.radius} fill="currentColor" />
          </>
        );

        return mark.href ? (
          <a class="world-map-dot" href={mark.href}>
            {dot}
          </a>
        ) : (
          <g>{dot}</g>
        );
      })
    }
  </svg>

  {
    caption && (
      <figcaption class="annotation">
        {marks.map((mark, index) => (
          <>
            {index > 0 && ' · '}
            {mark.href ? <a href={mark.href}>{mark.point.label}</a> : mark.point.label}
          </>
        ))}
        {unplaced.length > 0 && ` · no coordinates yet: ${unplaced.join(', ')}`}
        <br />
        Dots sit at country level, not at data centres — the dataset records which countries a provider operates in, not
        where the racks are.
      </figcaption>
    )
  }
</figure>
