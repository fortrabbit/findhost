---
import { countryPoints, landPath, latLngToXY, spacing, viewBox } from '../lib/map';
import { slugify } from '../lib/fields';

interface Props {
  /** ISO country codes to mark. Repeats are counted, not deduplicated. */
  regions: string[];
  /** Countries carrying more records get a larger dot. */
  weighted?: boolean;
  /** Where a dot leads. `{code}`, `{lower}` and `{slug}` are replaced — '#{lower}', '/regions/{slug}/'. */
  linkPattern?: string;
  /** Let the map use the width of the screen rather than the reading column. */
  full?: boolean;
  /** Off where the map is a doorway rather than the subject — /regions/ is where the detail lives. */
  caption?: boolean;
  /** Centre it in its column, for the one place it is an image rather than a figure in a text flow. */
  centred?: boolean;
  label: string;
}

const { regions, weighted = false, linkPattern, full = false, caption = true, centred = false, label } = Astro.props;

const counts = new Map<string, number>();
for (const code of regions) counts.set(code, (counts.get(code) ?? 0) + 1);

const highest = Math.max(1, ...counts.values());

const marks = [...counts.entries()]
  .filter(([code]) => countryPoints[code])
  .map(([code, count]) => {
    const point = countryPoints[code]!;
    const scale = weighted ? 0.6 + (count / highest) * 0.9 : 1;

    /*
     * A country with separate hosting regions is drawn at each of them, with the
     * radius divided so the total area is what one dot would have been. The
     * country reads as a spread rather than a pinpoint, and does not gain ink
     * for being large.
     */
    const anchors = [{ lat: point.lat, lng: point.lng }, ...(point.spread ?? [])];
    const radius = (spacing * 1.1 * scale) / Math.sqrt(anchors.length);

    return {
      code,
      count,
      point,
      anchors: anchors.map((anchor) => ({ ...latLngToXY(anchor.lat, anchor.lng), radius })),
      href: linkPattern
        ?.replace('{code}', code)
        .replace('{lower}', code.toLowerCase())
        .replace('{slug}', slugify(point.label)),
    };
  })
  .sort((a, b) => a.code.localeCompare(b.code, 'en'));

const unplaced = [...counts.keys()].filter((code) => !countryPoints[code]);
---

<figure class:list={['world-map', full && 'full-width', centred && 'world-map-centred']}>
  {/* A map with links in it is not an image: role=img hides its own countries from a screen reader. */}
  <svg viewBox={viewBox} xmlns="http://www.w3.org/2000/svg" role={linkPattern ? 'group' : 'img'} aria-label={label}>
    {/* Full opacity and a smaller dot. Fading ink to 35% is how grey gets made, and there is no grey here. */}
    <path
      d={landPath}
      fill="none"
      stroke="currentColor"
      stroke-width={spacing * 0.34}
      stroke-linecap="round"
      stroke-dasharray={`0 ${spacing}`}></path>
    {
      marks.map((mark) => {
        const dot = (
          <>
            <title>
              {mark.point.label}
              {weighted && ` — ${mark.count} ${mark.count === 1 ? 'provider' : 'providers'}`}
            </title>
            {mark.anchors.map((anchor) => (
              <>
                {/* A dot is smaller than a finger, so the target is not the dot. */}
                <circle
                  cx={anchor.x}
                  cy={anchor.y}
                  r={Math.max(anchor.radius * 2.4, spacing * 2.4)}
                  fill="transparent"
                />
                <circle cx={anchor.x} cy={anchor.y} r={anchor.radius} fill="currentColor" />
              </>
            ))}
          </>
        );

        return mark.href ? (
          <a class="world-map-dot" href={mark.href}>
            {dot}
          </a>
        ) : (
          <g>{dot}</g>
        );
      })
    }
  </svg>

  {
    caption && (
      <figcaption class="annotation">
        {marks.map((mark, index) => (
          <>
            {index > 0 && ' · '}
            {mark.href ? <a href={mark.href}>{mark.point.label}</a> : mark.point.label}
          </>
        ))}
        {unplaced.length > 0 && ` · no coordinates yet: ${unplaced.join(', ')}`}
      </figcaption>
    )
  }
</figure>
