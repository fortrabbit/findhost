---
import ProviderList from './ProviderList.astro';
import ListControls, { type Sort } from './ListControls.astro';
import { facetIndex, type Facet, type ProviderRow } from '../lib/facets';
import { byDate } from '../lib/rows';

interface Props {
  providers: ProviderRow[];
  facets: Facet[];
  /*
   * The facet value this page already stands for. A page that means one value
   * gets no filters: its URL is the narrowing, so a tick that contradicted it
   * would leave the heading, the prose and the address bar saying three
   * different things. It gets a link into the register instead, already ticked,
   * which is the page where combining values belongs.
   */
  seed?: { facet: string; value: string; label: string };
  /*
   * The page is its own narrowing and has already counted itself, but names no
   * facet value — the groups beside the register. Same list, same headings, same
   * toggle; no summary, no panel, no "every facet is also a link" fallback,
   * because none of those is true of a page the filters do not reach.
   */
  bare?: boolean;
  /*
   * The groups that sit beside the register, on a row under the line that counts
   * it. They were a column in the filter panel, which put links that are not
   * filters among fourteen columns that are; then a clause on the end of the
   * count, which read as one sentence naming eight numbers and parsed as none.
   * A row of links is the shape a reader already scans elsewhere on this page.
   */
  beside?: { label: string; href: string; count: number }[];
  /*
   * Which order the rows are in, and so which tab is lit. Only the register
   * offers a choice — a narrowed page is one order, the alphabet, and shows no
   * tabs. The rows arrive alphabetical whatever the order; the dated ones are
   * sorted here, since the grouping decides the sort.
   */
  sort?: Sort;
}

const { providers, facets, seed, bare, beside = [], sort } = Astro.props;

/*
 * Built here rather than in the template. Astro drops a whitespace-only text
 * node between two expressions, so `{n} {noun}` in markup renders "150records"
 * the moment a formatter puts them on separate lines. A string cannot be
 * reflowed into a bug.
 *
 * The wording matches what find.ts writes here once a filter changes.
 */
const summary = `${providers.length} ${providers.length === 1 ? 'web host' : 'web hosts'}.`;

// Grouped by initial so the register can be scanned and linked to without JavaScript.
const letterOf = (name: string) => {
  const initial = name.replace(/^the /i, '').charAt(0).toUpperCase();
  return /[A-Z]/.test(initial) ? initial : '#';
};

/*
 * Same reason as the summary: the count and the label are one string rather than
 * two expressions a formatter could put on separate lines.
 */
const besideLinks = beside.map((group) => ({
  href: group.href,
  /* The label as the dictionary wrote it. Lowercasing it read as prose and cost
     the acronyms — "2 domains and dns" for a group about DNS. */
  text: `${group.count} ${group.label}`,
}));

const letterGroups = [...new Set(providers.map((provider) => letterOf(provider.name)))].sort().map((letter) => ({
  // The heading already carries a `#` as its anchor link, so the numeric group
  // says what it holds instead of repeating the glyph.
  label: letter === '#' ? '0–9' : letter,
  anchor: letter === '#' ? 'other' : letter.toLowerCase(),
  rows: providers.filter((provider) => letterOf(provider.name) === letter),
}));

/*
 * A dated order is one list with no headings. Grouping it by month would put a
 * date over every row, and a register nobody has re-read for a while would say
 * so in its own subheadings; until records are re-checked on a schedule, the
 * order is the claim and the date stays on the record page. The single section
 * keeps the markup find.ts expects, so filtering hides rows the same way.
 */
const dated = sort === 'updated' || sort === 'added';
const groups = dated
  ? [{ label: '', anchor: 'list', rows: [...providers].sort(byDate(sort === 'updated' ? 'checkedAt' : 'addedAt')) }]
  : letterGroups;
---

{
  /* A seeded page has already counted itself, in a sentence that says more than this one. */
  !seed && !bare && (
    <div class="register-head">
      <p class="annotation" data-find-summary data-find-count>
        {summary}
      </p>

      {besideLinks.length > 0 && (
        <nav class="beside-links" aria-label="Beside the register" data-pagefind-ignore>
          {besideLinks.map((link) => (
            <a href={link.href}>{link.text}</a>
          ))}
        </nav>
      )}
    </div>
  )
}

{
  /* The filter panel, passed in rather than owned: it is markup the register does not need to know about. */
  !seed && !bare && <slot />
}

<ListControls sort={sort} />

<div data-pagefind-ignore data-find-results>
  {
    groups.map((group) => (
      <section class:list={['letter-group', { dated }]} id={group.anchor}>
        {!dated && (
          <h2>
            <a class="anchor-link" href={`#${group.anchor}`} aria-label={`Link to ${group.label}`}>
              {group.label}
            </a>
          </h2>
        )}
        <ProviderList providers={group.rows} />
      </section>
    ))
  }
</div>

{
  !seed && !bare && (
    <div data-find-fallback>
      <p class="annotation">
        Filtering needs JavaScript; the list above does not. Every facet value also has a page of its own, which is the
        same list narrowed the same way:
      </p>

      <ul class="entry-list">
        {facets.map((facet) => (
          <li>
            <a href={facetIndex(facet.id)}>{facet.label}</a>
            <span class="entry-count">{facet.values.filter((value) => value.count > 0).length}</span>
          </li>
        ))}
      </ul>
    </div>
  )
}
