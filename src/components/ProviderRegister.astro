---
import ProviderList from './ProviderList.astro';
import type { Facet, ProviderRow } from '../lib/facets';

interface Props {
  providers: ProviderRow[];
  facets: Facet[];
  /*
   * The facet value this page already stands for. `/software/wordpress/` renders
   * the register narrowed to WordPress and hands find.ts the same narrowing, so
   * the page a crawler reads and the page a filter produces are one page.
   */
  seed?: { facet: string; value: string };
}

const { providers, facets, seed } = Astro.props;

/*
 * Built here rather than in the template. Astro drops a whitespace-only text
 * node between two expressions, so `{n} {noun}` in markup renders "150records"
 * the moment a formatter puts them on separate lines. A string cannot be
 * reflowed into a bug.
 *
 * The wording matches what find.ts writes here once a filter changes, and it
 * states the order, because position is not ranking.
 */
const summary = `${providers.length} ${providers.length === 1 ? 'record' : 'records'}, sorted alphabetically.`;

// Grouped by initial so the register can be scanned and linked to without JavaScript.
const letterOf = (name: string) => {
  const initial = name.replace(/^the /i, '').charAt(0).toUpperCase();
  return /[A-Z]/.test(initial) ? initial : '#';
};

const groups = [...new Set(providers.map((provider) => letterOf(provider.name)))].sort().map((letter) => ({
  letter,
  // The heading already carries a `#` as its anchor link, so the numeric group
  // says what it holds instead of repeating the glyph.
  label: letter === '#' ? '0–9' : letter,
  anchor: letter === '#' ? 'other' : letter.toLowerCase(),
  rows: providers.filter((provider) => letterOf(provider.name) === letter),
}));
---

<p class="annotation" data-find-summary>{summary}</p>

<div
  class="find-filters"
  data-find-filters
  data-find-seed={seed ? `${seed.facet}:${seed.value}` : undefined}
  data-find-seed-path={seed ? Astro.url.pathname : undefined}
>
</div>

<div data-find-results>
  {
    groups.map((group) => (
      <section class="letter-group" id={group.anchor}>
        <h2>
          <a class="anchor-link" href={`#${group.anchor}`} aria-label={`Link to ${group.label}`}>
            #
          </a>
          {group.label}
        </h2>

        <ProviderList providers={group.rows} />
      </section>
    ))
  }
</div>

<div data-find-fallback>
  <p class="annotation">
    Filtering needs JavaScript; the list above does not. Every facet value also has a page of its own, which is the same
    list narrowed the same way:
  </p>

  <ul class="entry-list">
    {
      facets.map((facet) => (
        <li>
          <a href={`/${facet.id}/`}>{facet.label}</a>
          <span class="entry-count">{facet.values.filter((value) => value.count > 0).length}</span>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import '../scripts/find.ts';
</script>
