---
import { getCollection } from 'astro:content';

interface Props {
  /** Pathname of the page this nav is on, so it can mark where the reader is. */
  current: string;
}

const { current } = Astro.props;

/*
 * Every guide, in reading order. The guide is short enough to list whole: a
 * reader on one article can see the shape of the rest without going back to an
 * index.
 */
const guides = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);

const items = guides.map((guide) => ({ href: `/guide/${guide.id}/`, label: guide.data.title }));

/* The written pages that are not guide articles. They are read the same way and belong in the same list. */
const about = [
  { href: '/category/', label: 'Hosting categories' },
  { href: '/pricing/', label: 'How prices are recorded' },
  { href: '/about/', label: 'About' },
  { href: '/policies/', label: 'Policies' },
];
---

<nav class="guide-nav" aria-label="Guide">
  <h2>Guide</h2>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>

  <h2>This site</h2>
  <ul>
    {
      about.map((item) => (
        <li>
          <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
