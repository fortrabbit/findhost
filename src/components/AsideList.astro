---
import ProviderList from './ProviderList.astro';
import type { ProviderRow } from '../lib/facets';

/**
 * A group that sits beside the register: the ones that stopped trading, the
 * companies that sell no hosting, the records we have not finished.
 *
 * A page rather than a checkbox. They were a tick that appended a second list
 * under the register, which answered "show me these" with "here are those and
 * also everything else" — and left the only way to them unlinkable. A list is a
 * list; it gets an address.
 */
interface Props {
  title: string;
  /** One line under the heading: what this group is, and why it is not counted. */
  note: string;
  rows: ProviderRow[];
}

const { title, note, rows } = Astro.props;
---

<p class="crumb" data-pagefind-ignore><a href="/">The register</a></p>

<div class="page-head">
  <h1>{title}</h1>
</div>

<p class="annotation">{note}</p>

{
  rows.length > 0 ? (
    <ProviderList providers={rows} />
  ) : (
    <p class="annotation">
      Nothing here yet. The group exists because the dataset can describe it, and it will fill as records are checked.
    </p>
  )
}
