---
import AiDisclosure from '../components/AiDisclosure.astro';
import type { AiLevel } from '../components/AiDisclosure.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

interface Props {
  title: string;
  description?: string;
  ai?: AiLevel;
  /** Path to the same page as markdown, announced for readers that prefer text. */
  markdown?: string;
}

const { title, description, ai, markdown } = Astro.props;
const fathomSiteId = import.meta.env.PUBLIC_FATHOM_SITE_ID;

// Belt and braces with robots.txt: the file stops the crawl, this stops a URL
// someone links to from being listed anyway.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';

// Navigation lives in the footer. The top of the page says where you are; the
// bottom says where you can go. That makes the footer load-bearing rather than
// small print, which is the reason it is laid out rather than listed.
const sections = [
  { href: '/providers/', label: 'Providers' },
  { href: '/map/', label: 'Map' },
  { href: '/guide/why-hosting-is-hard/', label: 'Why hosting is hard' },
  { href: '/guide/how-to-choose/', label: 'How to choose' },
  { href: '/about/', label: 'About' },
  { href: '/policies/', label: 'Policies' },
  { href: '/rejected/', label: 'Not listed' },
];

const contribute = [
  { href: 'https://github.com/fortrabbit/findhost', label: 'Add a provider' },
  { href: 'https://github.com/fortrabbit/findhost/issues', label: 'Corrections' },
  { href: 'https://github.com/fortrabbit/findhost', label: 'GitHub' },
];

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="FindHost" />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:card" content="summary" />
    {fathomSiteId && <script is:inline src="https://cdn.usefathom.com/script.js" data-site={fathomSiteId} defer />}
  </head>
  <body>
    <header>
      <a href="/" class="wordmark" aria-current={path === '/' ? 'page' : undefined}>FindHost</a>

      <form class="site-search" role="search" action="/search/">
        <input
          type="search"
          name="q"
          placeholder="Search providers and guide"
          aria-label="Search"
          title="Press / to search"
          data-search-shortcut
        />
        <button type="submit">Search</button>
      </form>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <nav class="footer-nav">
        {
          sections.map((section) => (
            <a href={section.href} aria-current={path === section.href ? 'page' : undefined}>
              {section.label}
            </a>
          ))
        }
      </nav>

      <p class="footer-contribute">
        {
          contribute.map((link, index) => (
            <>
              {index > 0 && ' · '}
              <a href={link.href}>{link.label}</a>
            </>
          ))
        }
      </p>

      <AiDisclosure ai={ai} />

      <div class="footer-base">
        <p>
          A pet project by <a href="https://www.fortrabbit.com/about#frank">Frank Lämmer</a>. Published by <a
            href="/providers/fortrabbit/">fortrabbit</a
          >, who also appear in the dataset. Code under MIT, data under <a
            href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a
          >.
        </p>
        <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
          <span data-theme-label>Dark</span>
        </button>
      </div>
    </footer>

    <script is:inline>
      // Before first paint, or the page flashes the wrong theme on the way in.
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || stored === 'light') document.documentElement.dataset.theme = stored;
    </script>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const label = document.querySelector<HTMLElement>('[data-theme-label]');

      const dark = () =>
        root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;

      const describe = () => {
        if (!toggle || !label) return;
        label.textContent = dark() ? 'Light' : 'Dark';
        toggle.setAttribute('aria-pressed', String(dark()));
        toggle.title = `Switch to ${dark() ? 'light' : 'dark'}`;
      };

      toggle?.addEventListener('click', () => {
        const next = dark() ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
        describe();
      });

      describe();

      // `/` focuses search, the way it works everywhere else a developer types.
      const field = document.querySelector<HTMLInputElement>('[data-search-shortcut]');

      document.addEventListener('keydown', (event) => {
        if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;

        const active = document.activeElement;
        const typing =
          active instanceof HTMLInputElement ||
          active instanceof HTMLTextAreaElement ||
          (active instanceof HTMLElement && active.isContentEditable);
        if (typing) return;

        event.preventDefault();
        field?.focus();
        field?.select();
      });
    </script>
  </body>
</html>
