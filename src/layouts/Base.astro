---
import AiDisclosure from '../components/AiDisclosure.astro';
import type { AiLevel } from '../components/AiDisclosure.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

interface Props {
  title: string;
  description?: string;
  ai?: AiLevel;
}

const { title, description, ai } = Astro.props;
const fathomSiteId = import.meta.env.PUBLIC_FATHOM_SITE_ID;

// Belt and braces with robots.txt: the file stops the crawl, this stops a URL
// someone links to from being listed anyway.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';

const sections = [
  { href: '/providers/', label: 'Providers', owns: ['/providers/', '/category/'] },
  { href: '/map/', label: 'Map', owns: ['/map/', '/regions/'] },
  { href: '/guide/', label: 'Guide', owns: ['/guide/'] },
  { href: '/about/', label: 'About', owns: ['/about/'] },
];

// A record and a category page both live under Providers, so the nav says where
// you are rather than only where you clicked.
const path = Astro.url.pathname;
const current = sections.find((section) => section.owns.some((prefix) => path.startsWith(prefix)));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {fathomSiteId && <script is:inline src="https://cdn.usefathom.com/script.js" data-site={fathomSiteId} defer />}
  </head>
  <body>
    <header>
      <a href="/" class="wordmark" aria-current={path === '/' ? 'page' : undefined}>FindHost</a>
      <nav class="site-nav">
        {
          sections.map((section) => (
            <a href={section.href} aria-current={section === current ? 'page' : undefined}>
              {section.label}
            </a>
          ))
        }
      </nav>
      <form class="site-search" role="search" action="/search/">
        <input
          type="search"
          name="q"
          placeholder="Search providers and guide"
          aria-label="Search"
          title="Press / to search"
          data-search-shortcut
        />
        <button type="submit">Search</button>
      </form>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <AiDisclosure ai={ai} />
      <p>
        Published by fortrabbit, who also appear in the dataset. Code under MIT, data under <a
          href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a
        >.
      </p>
    </footer>

    <script>
      // `/` focuses search, the way it works everywhere else a developer types.
      const field = document.querySelector<HTMLInputElement>('[data-search-shortcut]');

      document.addEventListener('keydown', (event) => {
        if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;

        const active = document.activeElement;
        const typing =
          active instanceof HTMLInputElement ||
          active instanceof HTMLTextAreaElement ||
          (active instanceof HTMLElement && active.isContentEditable);
        if (typing) return;

        event.preventDefault();
        field?.focus();
        field?.select();
      });
    </script>
  </body>
</html>
