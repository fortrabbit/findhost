---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import { facetFields, facetOf } from '../lib/fields';

interface Props {
  title: string;
  description?: string;
  /** Path to the same page as markdown, announced for readers that prefer text. */
  markdown?: string;
  /** A record kept for reference but not on show: out of the index and out of search, whatever the site-wide flag says. */
  hidden?: boolean;
}

const { title, description, markdown, hidden = false } = Astro.props;
const fathomSiteId = import.meta.env.PUBLIC_FATHOM_SITE_ID;

// Belt and braces with robots.txt: the file stops the crawl, this stops a URL
// someone links to from being listed anyway.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true' && !hidden;

/*
 * The writing about the register, and who is behind it. The register itself is
 * the homepage, which the wordmark already leads back to. The map and the
 * policies are reached from the pages that need them rather than from every
 * page — a nav that lists everything is a nav nobody reads.
 */
const sections = [
  { href: '/guide/', label: 'Guide' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site ?? Astro.url).href;

/*
 * The page above this one, and only that one. It lives here rather than in each
 * template so the heading under it starts at the same height on every page —
 * which is the whole point, and why the space is held even where there is no
 * parent to name.
 *
 * A record's parent is the register, and the register is the homepage. Naming
 * it "Providers" rather than "Home" says what is up there instead of where.
 */
const [first, second] = path.split('/').filter(Boolean);

const parent = !second
  ? undefined
  : first === 'providers'
    ? { href: '/', label: 'Providers' }
    : first === 'guide'
      ? { href: '/guide/', label: 'Guide' }
      : facetFields.some((field) => field.facet === first)
        ? { href: `/${first}/`, label: facetOf(first).label }
        : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="FindHost" />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:card" content="summary" />
    {fathomSiteId && <script is:inline src="https://cdn.usefathom.com/script.js" data-site={fathomSiteId} defer />}
  </head>
  <body data-pagefind-ignore={hidden ? 'all' : undefined}>
    <header>
      <a href="/" class="wordmark" aria-current={path === '/' ? 'page' : undefined}>FindHost</a>

      <nav class="site-nav">
        {
          sections.map((section) => (
            <a href={section.href} aria-current={path.startsWith(section.href) ? 'page' : undefined}>
              {section.label}
            </a>
          ))
        }
      </nav>

      <form class="site-search" role="search" action="/search/">
        <input
          type="search"
          name="q"
          placeholder="Search providers and guide"
          aria-label="Search"
          title="Press / to search"
          data-search-shortcut
        />
      </form>
    </header>

    <main>
      {/* Rendered even when empty: the space it holds is what keeps every h1 at one height. */}
      <p class="breadcrumb">
        {parent ? <a href={parent.href}>{parent.label}</a> : <span aria-hidden="true">&nbsp;</span>}
      </p>

      <slot />
    </main>

    <footer>
      <div class="footer-base">
        <div>
          <p>
            Designed and curated by Frank Lämmer of <a href="/providers/fortrabbit/">fortrabbit</a>.
          </p>
          <p>
            Contributions welcome via <a href="https://github.com/fortrabbit/findhost">GitHub</a>.
          </p>
        </div>
        {/* Hidden until the script that makes it work has run, so it is never a control that does nothing. */}
        <button class="theme-toggle" type="button" data-theme-toggle hidden>
          <span data-theme-label>Dark</span>
        </button>
      </div>
    </footer>

    <script is:inline>
      // Before first paint, or the page flashes the wrong theme on the way in.
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || stored === 'light') document.documentElement.dataset.theme = stored;
    </script>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const label = document.querySelector<HTMLElement>('[data-theme-label]');

      const dark = () =>
        root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;

      /*
       * An action, not a state. The label names what pressing it will do, so
       * aria-pressed — which announces what the button currently *is* — would
       * contradict it: "Dark, pressed" where the page is light.
       */
      const describe = () => {
        if (!toggle || !label) return;
        label.textContent = dark() ? 'Light' : 'Dark';
        toggle.title = `Switch to ${dark() ? 'light' : 'dark'}`;
      };

      toggle?.addEventListener('click', () => {
        const next = dark() ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
        describe();
      });

      describe();
      if (toggle) toggle.hidden = false;

      // `/` focuses search, the way it works everywhere else a developer types.
      const field = document.querySelector<HTMLInputElement>('[data-search-shortcut]');

      document.addEventListener('keydown', (event) => {
        if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;

        const active = document.activeElement;
        const typing =
          active instanceof HTMLInputElement ||
          active instanceof HTMLTextAreaElement ||
          (active instanceof HTMLElement && active.isContentEditable);
        if (typing) return;

        event.preventDefault();
        field?.focus();
        field?.select();
      });
    </script>
  </body>
</html>
