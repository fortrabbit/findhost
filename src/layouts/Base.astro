---
import AiDisclosure from '../components/AiDisclosure.astro';
import type { AiLevel } from '../components/AiDisclosure.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

interface Props {
  title: string;
  description?: string;
  ai?: AiLevel;
}

const { title, description, ai } = Astro.props;
const fathomSiteId = import.meta.env.PUBLIC_FATHOM_SITE_ID;

// Belt and braces with robots.txt: the file stops the crawl, this stops a URL
// someone links to from being listed anyway.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {fathomSiteId && <script is:inline src="https://cdn.usefathom.com/script.js" data-site={fathomSiteId} defer />}
  </head>
  <body>
    <header>
      <a href="/" class="wordmark">FindHost</a>
      <nav class="site-nav">
        <a href="/find/">Find</a>
        <a href="/map/">Map</a>
        <a href="/guide/">Guide</a>
        <a href="/about/">About</a>
      </nav>
      <form class="site-search" role="search" action="/search/">
        <input type="search" name="q" placeholder="Search providers and guide" aria-label="Search" />
        <button type="submit">Search</button>
      </form>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <AiDisclosure ai={ai} />
      <p>
        Published by fortrabbit, who also appear in the dataset. Code under MIT, data under <a
          href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a
        >.
      </p>
    </footer>
  </body>
</html>
