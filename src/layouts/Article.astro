---
import Base from './Base.astro';
import GuideNav from '../components/GuideNav.astro';
import type { AiLevel } from '../components/AiDisclosure.astro';

/*
 * Every written page: the guide articles, About, Policies. One layout, so a page
 * of prose looks the same wherever it sits and gains the aside nav without
 * anyone remembering to add it. Records and lists are not this — they are
 * scanned, not read.
 */
interface Props {
  frontmatter: {
    title: string;
    description?: string;
    lead?: string;
    figure?: { emoji: string; color: string; textColor: string; text: string };
    ai?: AiLevel;
  };
}

const { frontmatter } = Astro.props;
const { figure } = frontmatter;
---

<Base title={`${frontmatter.title} — FindHost`} description={frontmatter.description} ai={frontmatter.ai}>
  {
    /* Outside the grid: a band that bleeds to both page edges cannot be measured from inside a column. */
    figure && (
      <p class="figure-band full-bleed" style={`background:${figure.color};color:${figure.textColor}`}>
        <span aria-hidden="true">{figure.emoji}</span> {figure.text}
      </p>
    )
  }

  <div class="guide-layout full-width">
    <GuideNav current={Astro.url.pathname} />

    <article>
      <h1>{frontmatter.title}</h1>
      {frontmatter.lead && <p class="lead">{frontmatter.lead}</p>}

      <slot />
    </article>
  </div>
</Base>
