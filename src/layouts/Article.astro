---
import Base from './Base.astro';
import PageFigure from '../components/PageFigure.astro';

/*
 * Every written page: the guide articles, About, Policies. One layout, so a page
 * of prose looks the same wherever it sits. Records and lists are not this —
 * they are scanned, not read.
 */
interface Props {
  frontmatter: {
    title: string;
    description?: string;
    lead?: string;
    figure?: { emoji: string; color: string; textColor: string; text: string };
  };
}

const { frontmatter } = Astro.props;
const { figure } = frontmatter;
---

<Base title={`${frontmatter.title} — FindHost`} description={frontmatter.description}>
  <article>
    <h1>{frontmatter.title}</h1>
    {frontmatter.lead && <p class="lead">{frontmatter.lead}</p>}
    <PageFigure figure={figure} />

    <slot />
  </article>
</Base>
