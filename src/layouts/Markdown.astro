---
import Base from './Base.astro';
import type { AiLevel } from '../components/AiDisclosure.astro';

interface Props {
  frontmatter: { title: string; description?: string; ai?: AiLevel };
}

const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} — FindHost`} description={frontmatter.description} ai={frontmatter.ai}>
  <article>
    <h1>{frontmatter.title}</h1>
    <slot />
  </article>
</Base>
