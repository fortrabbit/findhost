---
import Base from '../layouts/Base.astro';
import ProviderList from '../components/ProviderList.astro';
import ListControls from '../components/ListControls.astro';
import { loadProviders } from '../lib/providers';
import { organization } from '../lib/seo';
import { loadSignal, coverageFloor } from '../lib/signal';

/*
 * The register in our order rather than in alphabetical order — the one page on
 * this site that expresses a preference, and so the one that has to argue for
 * itself hardest.
 *
 * A plain ranked list, highest first. Bands and a shuffle were tried and taken
 * out again: they hid the ordering without changing it, which is a worse kind of
 * honesty than showing the number and saying whose it is. Where the arithmetic
 * reads wrong, `signalAdjustment` moves a record in public.
 */
const signal = await loadSignal();

const scored = (await loadProviders())
  .map((provider) => ({ provider, total: signal.of(provider.data as Record<string, unknown>).total }))
  .sort((a, b) => b.total - a.total || a.provider.data.name.localeCompare(b.provider.data.name, 'en'));

const row = ({ provider, total }: (typeof scored)[number]) => ({
  id: provider.id,
  name: provider.data.name,
  description: provider.data.description,
  greenWebId: provider.data.greenWebId,
  country: provider.data.hqCountry,
  figure: provider.data.figure,
  signal: total,
});

/* Every record a person has put a thumb on, listed in full further down. */
const adjusted = scored
  .filter((entry) => entry.provider.data.signalAdjustment)
  .map((entry) => ({ provider: entry.provider, adjustment: entry.provider.data.signalAdjustment! }))
  .sort((a, b) => a.provider.data.name.localeCompare(b.provider.data.name, 'en'));

const origin = Astro.site?.origin ?? '';
---

<Base
  title="FindHost Signal — FindHost"
  description="The register in our order instead of alphabetical order, with the whole of the arithmetic published on the same page."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'FindHost Signal',
    numberOfItems: scored.length,
    isPartOf: organization(origin),
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: scored.map(({ provider }, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${origin}/${provider.id}/`,
      name: provider.data.name,
    })),
  }}
>
  <div class="page-head">
    <h1>FindHost Signal</h1>
  </div>

  <p class="lead">Our taste, as arithmetic, published in full.</p>

  <p>
    The register is alphabetical everywhere else, because a number attached to a hosting provider is usually somebody's
    commission wearing a lab coat. This page is the exception, and it says whose opinion it is: fortrabbit's, who
    publish the register and appear in it.
  </p>

  <p>
    Scores are computed from fields already recorded on each provider's page, never written into a record, and
    <a href="#weights">the whole of the arithmetic is below</a>. Where it reads wrong, a person may move a record by
    hand — with a name, a date and a reason, listed at the foot of this page.
  </p>

  <ListControls sort="signal" />

  <div data-find-results>
    <ProviderList providers={scored.map(row)} withSignal />
  </div>

  <h2 id="weights">The whole of it</h2>

  <p>
    A field nobody has recorded yet scores nothing, so an unfinished record sits lower than a finished one — a fact
    about our work rather than about the provider.
  </p>

  <table class="signal-table">
    <thead>
      <tr>
        <th scope="col">What it rewards</th>
        <th scope="col">Points</th>
      </tr>
    </thead>
    <tbody>
      {
        signal.awake.map((weight) => (
          <tr>
            <td>{weight.label}</td>
            <td class="signal-points">{weight.points}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  {
    signal.asleep.length > 0 && (
      <>
        <h2>The weights that are asleep</h2>

        <p>
          A weight counts only while at least {Math.round(coverageFloor * 100)}% of the register answers the field it
          reads. These do not, so they score nothing for anybody — including for us.
        </p>

        <p>
          The rule exists because the first version of this page did not have it, and rewarded three fields that two or
          three records out of {signal.asleep[0].of} answered — fortrabbit among them every time. It was measuring which
          record we had researched most carefully, which was our own. These wake by themselves as the research fills in.
        </p>

        <table class="signal-table">
          <thead>
            <tr>
              <th scope="col">Asleep</th>
              <th scope="col">Answered by</th>
            </tr>
          </thead>
          <tbody>
            {signal.asleep.map(({ weight, covered, of }) => (
              <tr>
                <td>{weight.label}</td>
                <td class="signal-points">
                  {covered} of {of}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }
  {
    adjusted.length > 0 && (
      <>
        <h2>Hand adjustments</h2>

        <p>
          The arithmetic cannot see everything. Rather than quietly bend a weight until the list looked right — the same
          act with the evidence removed — a person may add or subtract points on one record, and every one of them is
          here with a name, a date and a reason.
        </p>

        <table class="signal-table">
          <thead>
            <tr>
              <th scope="col">Provider</th>
              <th scope="col">Why</th>
              <th scope="col">Points</th>
            </tr>
          </thead>
          <tbody>
            {adjusted.map(({ provider, adjustment }) => (
              <tr>
                <td>
                  <a href={`/${provider.id}/`}>{provider.data.name}</a>
                </td>
                <td>
                  {adjustment.why} — {adjustment.by}, {adjustment.on.toISOString().slice(0, 10)}
                </td>
                <td class="signal-points">{adjustment.points > 0 ? `+${adjustment.points}` : adjustment.points}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }
</Base>

{/* For the extended/slim toggle only. This page ships no filters — its order is the point. */}
<script>
  import '../scripts/find.ts';
</script>
