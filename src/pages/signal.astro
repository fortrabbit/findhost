---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageFigure from '../components/PageFigure.astro';
import { loadProviders } from '../lib/providers';
import { organization } from '../lib/seo';
import { loadSignal } from '../lib/signal';

/*
 * What the Signal is and why, in prose — and the tables, which are generated.
 *
 * The split is the point. The argument is written by a person and lives in
 * src/content/notes/page/signal.md, where it can be edited without touching
 * code. The weights are rendered from the array the ordering actually runs on,
 * so the published algorithm cannot drift from the running one. Keeping the
 * table in markdown and updating it whenever the code changes would work exactly
 * until the first time somebody forgot, and nothing on the page would say so.
 *
 * The ranked list is not repeated here. It is the register in another order, it
 * lives at /?sort=signal where the filters still work, and a second copy would be
 * a second thing to keep true.
 */
const signal = await loadSignal();

const notes = await getCollection('notes');
const note = notes.find((entry) => entry.id === 'page/signal');
const Note = note ? (await render(note)).Content : null;

const adjusted = (await loadProviders())
  .filter((provider) => provider.data.signalAdjustment)
  .map((provider) => ({ provider, adjustment: provider.data.signalAdjustment! }))
  .sort((a, b) => a.provider.data.name.localeCompare(b.provider.data.name, 'en'));

const origin = Astro.site?.origin ?? '';
---

<Base
  title={`${note?.data.title ?? 'Signal'} — FindHost`}
  description={note?.data.description}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Signal',
    url: `${origin}/signal/`,
    isPartOf: organization(origin),
  }}
>
  <div class="page-head">
    <h1>Signal</h1>
  </div>

  <PageFigure figure={note?.data.figure} />

  {Note && <Note />}

  <table class="signal-table">
    <thead>
      <tr>
        <th scope="col">What it rewards</th>
        <th scope="col">Points</th>
      </tr>
    </thead>
    <tbody>
      {
        signal.awake.map((weight) => (
          <tr>
            <td>{weight.label}</td>
            <td class="signal-points">{weight.points}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  {
    /*
     * Only where somebody has made one. The dormant weights are not listed at
     * all any more: a weight scoring nothing for every record is not part of the
     * running algorithm, and printing it invited a reader to check arithmetic
     * that was not happening.
     */
    adjusted.length > 0 && (
      <table class="signal-table">
        <thead>
          <tr>
            <th scope="col">Hand adjustment</th>
            <th scope="col">Why</th>
            <th scope="col">Points</th>
          </tr>
        </thead>
        <tbody>
          {adjusted.map(({ provider, adjustment }) => (
            <tr>
              <td>
                <a href={`/${provider.id}/`}>{provider.data.name}</a>
              </td>
              <td>
                {adjustment.why} — {adjustment.by}, {adjustment.on.toISOString().slice(0, 10)}
              </td>
              <td class="signal-points">{adjustment.points > 0 ? `+${adjustment.points}` : adjustment.points}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</Base>
