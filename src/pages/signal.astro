---
import Base from '../layouts/Base.astro';
import ProviderList from '../components/ProviderList.astro';
import ListControls from '../components/ListControls.astro';
import { loadProviders } from '../lib/providers';
import { organization } from '../lib/seo';
import { loadSignal, tiers, tierOf, coverageFloor } from '../lib/signal';

/*
 * The register in our order rather than in alphabetical order — the one page on
 * this site that expresses a preference, and so the one that has to argue for
 * itself hardest.
 *
 * Tiers rather than places. A strict ladder crowns something, and a register
 * that refuses to rate hosting has no business handing out a first place; a band
 * says "these are the ones we would look at" without pretending the difference
 * between the top two means anything. Inside a band the order is alphabetical.
 */
const signal = await loadSignal();

const scored = (await loadProviders()).map((provider) => ({
  provider,
  total: signal.of(provider.data as Record<string, unknown>).total,
}));

const row = ({ provider, total }: (typeof scored)[number]) => ({
  id: provider.id,
  name: provider.data.name,
  description: provider.data.description,
  publishedByUs: provider.data.publishedByUs,
  greenWebId: provider.data.greenWebId,
  country: provider.data.hqCountry,
  figure: provider.data.figure,
  signal: total,
});

const banded = tiers
  .map((tier) => ({
    tier,
    rows: scored
      .filter((entry) => tierOf(entry.total).id === tier.id)
      .sort((a, b) => a.provider.data.name.localeCompare(b.provider.data.name, 'en'))
      .map(row),
  }))
  .filter((band) => band.rows.length > 0);

const origin = Astro.site?.origin ?? '';
---

<Base
  title="FindHost Signal — FindHost"
  description="The register in our order instead of alphabetical order, with the whole of the arithmetic published on the same page."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'FindHost Signal',
    numberOfItems: scored.length,
    isPartOf: organization(origin),
    itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: banded.flatMap((band) =>
      band.rows.map((provider) => ({
        '@type': 'ListItem',
        url: `${origin}/${provider.id}/`,
        name: provider.name,
      })),
    ),
  }}
>
  <div class="page-head">
    <h1>FindHost Signal</h1>
  </div>

  <p class="lead">Our taste, as arithmetic, published in full.</p>

  <p>
    Everywhere else on this site the order is alphabetical and nothing is scored, because a number attached to a hosting
    provider is usually somebody's commission wearing a lab coat. This page is the exception, and it says whose opinion
    it is: fortrabbit's, who publish the register and appear in it. It rewards what we think makes a host worth finding
    — independence, a platform that can be driven from a script, somewhere to try a deploy before it is the site — and
    it will therefore treat fortrabbit kindly. Read it as an argument, not as a verdict.
  </p>

  <p>
    Nothing here is a rating of quality, and no provider can move up it by asking. The score is computed from fields
    already recorded on the page of each provider, it is never written into a record, and the whole of the arithmetic is
    <a href="#weights">the table below</a>. Every record shows its own score broken into the parts that earned it.
    Disagree with a weight and you are disagreeing with us in public, which is the point.
  </p>

  <p>
    There is no first place. Providers are grouped into bands and listed alphabetically inside them, because the
    difference between the top two scores is not a fact about hosting — it is a rounding of our own opinions. The
    <a href="/">register</a> can be put in this order too, where it keeps its filters.
  </p>

  <ListControls sort="signal" />

  <div data-find-results>
    {
      banded.map((band) => (
        <section class="letter-group">
          <h2>{band.tier.label}</h2>
          <ProviderList providers={band.rows} />
        </section>
      ))
    }
  </div>

  <h2 id="weights">The whole of it</h2>

  <p>
    Points are added for every provider, in this order, and the total is the sum of them. A field nobody has recorded yet
    scores nothing, which means an unfinished record sits lower than a finished one — a fact about our work rather than
    about the provider.
  </p>

  <table class="signal-table">
    <thead>
      <tr>
        <th scope="col">What it rewards</th>
        <th scope="col">Points</th>
      </tr>
    </thead>
    <tbody>
      {
        signal.awake.map((weight) => (
          <tr>
            <td>{weight.label}</td>
            <td class="signal-points">{weight.points}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  {
    signal.asleep.length > 0 && (
      <>
        <h2>The weights that are asleep</h2>

        <p>
          A weight counts only while at least {Math.round(coverageFloor * 100)}% of the register answers the field it
          reads. These do not, so they score nothing for anybody — including for us.
        </p>

        <p>
          The rule exists because the first version of this page did not have it. It rewarded an MCP server, a staging
          environment and team access: three fields answered by two or three records out of {signal.asleep[0].of}, and
          fortrabbit was among those three every time. It put the publisher of this register nine points clear at the
          top, and what it was measuring was not the hosting. It was which record we had researched most carefully,
          which was our own. These wake up by themselves as the research fills in.
        </p>

        <table class="signal-table">
          <thead>
            <tr>
              <th scope="col">Asleep</th>
              <th scope="col">Answered by</th>
            </tr>
          </thead>
          <tbody>
            {signal.asleep.map(({ weight, covered, of }) => (
              <tr>
                <td>{weight.label}</td>
                <td class="signal-points">
                  {covered} of {of}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }
</Base>

{/* For the extended/slim toggle only. This page ships no filters — its order is the point. */}
<script>
  import '../scripts/find.ts';
</script>
