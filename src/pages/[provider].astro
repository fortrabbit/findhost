---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { fieldGroups, fieldOf, labelOf, slugOf, type Field } from '../lib/fields';
import { energy, flag, footnotes, price } from '../lib/record';
import { isListed } from '../lib/providers';
import SocialLinks from '../components/SocialLinks.astro';
import PageFigure from '../components/PageFigure.astro';
import FactGroups from '../components/FactGroups.astro';

export async function getStaticPaths() {
  const providers = await getCollection('providers');
  return providers.map((provider) => ({
    params: { provider: provider.id },
    props: { provider },
  }));
}

const { provider } = Astro.props;

const { Content } = await render(provider);
const data = provider.data;
const valueOf = (field: string) => (data as Record<string, unknown>)[field];

/*
 * The rows, their order, their labels and the words their values are shown
 * under all come from src/data/fields.yml. The page used to carry its own list
 * of them, which is why two thirds of it printed raw ids: a label existed only
 * where a facet happened to want one.
 *
 * Meta and provenance have no entry there and no row here — they describe our
 * work, not the provider, so they do not belong in the denominator either.
 */
const groups = fieldGroups();
const allFields = groups.flatMap((group) => group.fields);

const held = (value: unknown) => value !== undefined && value !== null && (!Array.isArray(value) || value.length > 0);

/*
 * An explicit `null` means the question does not apply to this provider — a
 * panel that provisions onto your own cloud account has no regions of its own.
 * That is neither known nor missing, so it leaves the denominator entirely
 * rather than inflating the gap on records that have no gap.
 */
const applicable = allFields.filter((field) => valueOf(field.id) !== null);

// Known first. What is missing is named once, together, where it reads as an
// ask rather than as forty rows of `?`.
const knownGroups = groups
  .map((group) => ({ label: group.label, fields: group.fields.filter((field) => held(valueOf(field.id))) }))
  .filter((group) => group.fields.length > 0);

/*
 * What a customer decides on stays beside the prose; what describes the company
 * rather than the product falls below it. Automation is on the near side because
 * an MCP server and a CLI are what an agent-shaped reader is here for.
 */
const asideGroups = ['Pricing', 'Tech stack', 'Classification', 'Automation'];
const nearGroups = knownGroups.filter((group) => asideGroups.includes(group.label));
const farGroups = knownGroups.filter((group) => !asideGroups.includes(group.label));

const missing = applicable.filter((field) => !held(valueOf(field.id)));
const total = applicable.length;

/*
 * One value as the page shows it. A vocabulary field gets the reader's word for
 * it, and where that vocabulary is also a facet the word is a link to the page
 * of everything else holding it — which is the same fact the filter panel
 * offers, arrived at from the other side.
 */
interface Cell {
  text: string;
  href?: string;
  filter?: string;
}

const money = (entry: unknown) => {
  const paid = entry as { amount: number; currency: string; period: string; introductory?: boolean };
  const said = price(paid);
  return said && paid.introductory ? `${said}, introductory` : said;
};

function cells(field: Field, value: unknown): Cell[] {
  if (field.render === 'yes-no') return [{ text: value ? 'yes' : 'no' }];
  if (field.render === 'money') return [{ text: money(value) ?? '' }];
  if (field.render === 'multiple') return [{ text: `${String(value)}×` }];

  return (Array.isArray(value) ? value : [value]).map((entry) => {
    const label = labelOf(field.id, entry);
    if (!field.facet) return { text: label };
    const slug = slugOf(field, { id: String(entry), label });
    return { text: label, href: `/${field.facet}/${slug}/`, filter: `${field.facet}:${label}` };
  });
}

const linkLabels: Record<string, string> = {
  pricing: 'pricing',
  status: 'status',
  terms: 'terms',
  docs: 'docs',
};

// Pages the provider operates: the product, and the terms it is sold under.
// Where it posts is a different kind of link and sits on its own line.
const outgoing = [
  ...Object.entries(linkLabels)
    .filter(([key]) => data.urls[key as keyof typeof data.urls])
    .map(([key, label]) => [label, data.urls[key as keyof typeof data.urls] as string] as const),
  ...(data.sustainabilityUrl ? ([['sustainability', data.sustainabilityUrl]] as const) : []),
];

const { notes, numberOf } = footnotes(data.sources);

/* Groups as the component draws them: labels, resolved cells, and the source behind each row. */
const drawn = (groups: { label: string; fields: Field[] }[]) =>
  groups.map((group) => ({
    label: group.label,
    rows: group.fields.map((field) => ({
      label: field.label,
      cells: cells(field, valueOf(field.id)),
      note: numberOf.get(field.id),
    })),
  }));

/*
 * Sources for what this line holds. `urls` and `sustainabilityUrl` are cited
 * like any other fact and have no row to hang a marker on, so the marker goes
 * where the reader can see what it is about. Social accounts are not cited: a
 * profile link either resolves to the provider or it does not.
 */
const linkNotes = [...new Set(['urls', 'sustainabilityUrl'].map((field) => numberOf.get(field)))].filter(
  (note): note is number => note !== undefined,
);

/*
 * What each source backs, in the words the page uses for it. A source may name
 * no field at all — a claim made in the prose, cited inline — so anything
 * unmatched falls back to a readable form of the key rather than being dropped:
 * a source list that hides its own entries is worse than one with an unfamiliar
 * word in it.
 */
const sourceLabel = (field: string) =>
  fieldOf.get(field)?.label ??
  { notes: 'the notes', urls: 'links', social: 'accounts', sustainabilityUrl: 'sustainability' }[field] ??
  field.replace(/([A-Z])/g, ' $1').toLowerCase();

const energyClaim = energy(data.energyClaim);
const homeFlag = flag(data.hqCountry);

// The policy page promises staleness is computed from the recorded date rather
// than from a promise to re-check. This is where that is kept.
const staleAfterDays = 180;
const checkedDaysAgo = data.checkedAt ? Math.floor((Date.now() - data.checkedAt.getTime()) / 86_400_000) : undefined;
const stale = checkedDaysAgo !== undefined && checkedDaysAgo > staleAfterDays;

/* The scope test, in the order /policies/ numbers it. */
const criteria: Record<number, string> = {
  1: 'runs application code',
  2: 'sold to the public',
  3: 'public pricing',
  4: 'public technical documentation',
  5: 'twelve months old',
  6: 'two independent artifacts',
};

const statusNotice: Record<string, string> = {
  draft:
    'A stub. Started and not finished, so it is not in the register and not counted — what is here is what has been confirmed, and nothing has been left out on purpose.',
  acquired: 'Acquired, still operating.',
  renamed: 'Renamed. Same service under a new name.',
  'winding-down': 'Winding down: an end of life has been announced.',
  discontinued: 'Discontinued. The facts below are the last ones known to be true.',
  unverifiable: 'Basic facts can no longer be confirmed from public sources.',
  'delisted-on-request': 'The provider asked to be removed. The record stays; entries are never deleted.',
};

const listed = isListed(provider);

/*
 * Built rather than looked up, because it has to name the criterion: "not
 * listed" without one is an assertion, and this page is where the decision is
 * argued with.
 */
const outOfScope =
  data.status === 'out-of-scope' && data.criterion
    ? `Not listed. Fails criterion ${data.criterion} — ${criteria[data.criterion]}${
        data.boundedSearch ? ', recorded as a bounded search rather than as proof of absence' : ''
      }. Being out of scope is not a criticism and most of these are reversible: bring the missing evidence and the record goes in.`
    : undefined;

const notice = outOfScope ?? (typeof data.status === 'string' ? statusNotice[data.status] : undefined);
---

<Base
  title={`${data.name} — FindHost`}
  description={data.description}
  markdown={`/${provider.id}.md`}
  hidden={!listed}
>
  <article>
    <div class="record-head">
      <h1>{data.name}</h1>
      {
        energyClaim && (
          <span class="record-mark" title={energyClaim}>
            <span aria-hidden="true">🌱</span>
            <span class="visually-hidden">{energyClaim}</span>
          </span>
        )
      }
      {
        homeFlag && (
          <span class="record-mark record-country" title={labelOf('hqCountry', data.hqCountry)}>
            {data.hqCountry}
          </span>
        )
      }
    </div>
    {
      notice && (
        <aside class="editorial-note">
          <p>
            <strong>Status.</strong> {notice}
          </p>
        </aside>
      )
    }

    {
      stale && (
        <aside class="editorial-note">
          <p>
            <strong>May be out of date.</strong> Last checked {checkedDaysAgo} days ago.
          </p>
        </aside>
      )
    }

    {data.description && <p class="lead">{data.description}</p>}

    <p class="record-links">
      <a class="record-home" href={data.urls.home} rel="nofollow">{data.urls.home.replace('https://', '')}</a>
      {
        outgoing.map(([label, url]) => (
          <>
            <a href={url} rel="nofollow">
              {label}
            </a>
          </>
        ))
      }
      {
        linkNotes.map((note) => (
          <a class="footnote-ref" href={`#source-${note}`} aria-label={`Source ${note}`}>
            {note}
          </a>
        ))
      }
    </p>

    <SocialLinks social={data.social} />

    <PageFigure figure={data.figure} />

    <div class="record-layout">
      <aside class="record-specs">
        <FactGroups groups={drawn(nearGroups)} />

        {
          missing.length > 0 && (
            <details class="missing-fields">
              <summary>
                {missing.length} of {total} fields not recorded yet
              </summary>
              <p class="missing-list">{missing.map((field) => field.label).join(', ')}</p>
            </details>
          )
        }
      </aside>

      <div class="record-prose">
        <Content />

        {
          data.caveat && (
            <aside class="caveat">
              <p>
                <span aria-hidden="true">{data.caveat.emoji}</span> {data.caveat.text}
              </p>
              <p class="caveat-source">
                A judgement by {data.caveat.by}, {data.caveat.on.toISOString().slice(0, 10)}. Not a filterable field.
              </p>
            </aside>
          )
        }

        {
          data.editorialNote && (
            <aside class="editorial-note">
              <p>
                <strong>Disclosure.</strong> {data.editorialNote}
              </p>
            </aside>
          )
        }
      </div>
    </div>

    {farGroups.length > 0 && <FactGroups groups={drawn(farGroups)} class="record-extra" />}

    {
      notes.length > 0 && (
        <section class="sources">
          <h2>Sources</h2>
          <ol>
            {notes.map((note, index) => (
              <li id={`source-${index + 1}`}>
                <span class="source-date">{note.checkedAt.toISOString().slice(0, 10)}</span>:&nbsp;
                <span class="source-fields">{note.fields.map(sourceLabel).join(', ')}</span>
                <br />
                <a href={note.url} rel="nofollow">
                  {note.url.replace('https://', '')}
                </a>{' '}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <p class="annotation">
      <!-- {total - missing.length} of {total} attributes recorded. -->
      {data.checkedAt ? ` Last reviewed ${data.checkedAt.toISOString().slice(0, 10)}. ` : ' Never checked. '}
      <br />
      <a href={`https://github.com/fortrabbit/findhost/edit/main/src/content/providers/${provider.id}.md`}>
        Complete this record.
      </a>
    </p>
  </article>
</Base>
