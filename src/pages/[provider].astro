---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { fieldGroups, fieldOf, type Field } from '../lib/fields';
import { backlinks, cells, footnotes } from '../lib/record';
import { isListed } from '../lib/providers';
import { loadFacets } from '../lib/facets';
import { organization } from '../lib/seo';
import { cardPath } from '../lib/og';
import SocialLinks from '../components/SocialLinks.astro';
import PageFigure from '../components/PageFigure.astro';
import FactGroups from '../components/FactGroups.astro';
import infoIcon from 'bootstrap-icons/icons/info-lg.svg?raw';

export async function getStaticPaths() {
  const providers = await getCollection('providers');
  return providers.map((provider) => ({
    params: { provider: provider.id },
    props: { provider },
  }));
}

const { provider } = Astro.props;

const { Content } = await render(provider);
const data = provider.data;

/*
 * Every record, because a relation is read from both ends: this one names its
 * parent and its suppliers, and every other one may name this one as theirs.
 */
const everyRecord = await getCollection('providers');
const nameOf = new Map(everyRecord.map((entry) => [String(entry.data.id), entry.data.name]));
const valueOf = (field: string) => (data as Record<string, unknown>)[field];

/*
 * The other invoices. A provider recording `none` for one of these has said it
 * does not sell the thing, so the register can name who does.
 *
 * Only on an explicit `none`. An absent field means nobody checked, and telling
 * a reader a host has no email on that basis would be inventing the answer —
 * which is why this shows on few records today and more as they are filled in.
 * The category must be in use too, or the link points at a page never built.
 *
 * Databases are not here, and cannot be until the dictionary can say it.
 * `managedDatabases` is a list of engines, so it answers "which" and has no way
 * to answer "none": absent means nobody looked, and a great many platforms do
 * run a database — fortrabbit's own record names MySQL. Pairing a host with a
 * database service needs a three-value field of its own, like the ones domains
 * and email already have.
 */
const soldBy = new Set(
  everyRecord.filter(isListed).flatMap((entry) => (entry.data.category as string[] | undefined) ?? []),
);
const alsoNeeded = [
  { field: 'domainRegistration', need: 'A domain to point at it', category: 'domains-dns' },
  { field: 'emailHosting', need: 'Mailboxes on that domain', category: 'mail' },
].filter((pair) => valueOf(pair.field) === 'none' && soldBy.has(pair.category));

/*
 * The rows, their order, their labels and the words their values are shown
 * under all come from src/data/fields.yml. The page used to carry its own list
 * of them, which is why two thirds of it printed raw ids: a label existed only
 * where a facet happened to want one.
 *
 * Meta and provenance have no entry there and no row here — they describe our
 * work, not the provider, so they do not belong in the denominator either.
 */
const groups = fieldGroups();
const allFields = groups.flatMap((group) => group.fields);

const held = (value: unknown) => value !== undefined && value !== null && (!Array.isArray(value) || value.length > 0);

/*
 * An explicit `null` means the question does not apply to this provider — a
 * panel that provisions onto your own cloud account has no regions of its own.
 * That is neither known nor missing, so it leaves the denominator entirely
 * rather than inflating the gap on records that have no gap.
 */
const applicable = allFields.filter((field) => valueOf(field.id) !== null);

// Known first. What is missing is named once, together, where it reads as an
// ask rather than as forty rows of `?`.
const knownGroups = groups
  .map((group) => ({ label: group.label, fields: group.fields.filter((field) => held(valueOf(field.id))) }))
  .filter((group) => group.fields.length > 0);

/*
 * What a customer decides on stays beside the prose; what describes the company
 * rather than the product falls below it. Automation is on the near side because
 * an MCP server and a CLI are what an agent-shaped reader is here for.
 */
const besideTheProse = ['Pricing', 'Tech stack', 'Classification', 'Automation'];
const nearGroups = knownGroups.filter((group) => besideTheProse.includes(group.label));
const farGroups = knownGroups.filter((group) => !besideTheProse.includes(group.label));

const missing = applicable.filter((field) => !held(valueOf(field.id)));
const total = applicable.length;

/*
 * A value page exists only where a record in the register holds the value, so a
 * record beside the register can hold one nobody listed does — dotCloud ran
 * Perl and nothing trading today records it. The fact is still shown; it is the
 * link that would be a 404.
 */
const { facets: allFacets } = await loadFacets();
const context = {
  nameOf,
  hasPage: new Set(
    allFacets.flatMap((facet) =>
      facet.values.filter((value) => value.count > 0).map((value) => `${facet.field}:${value.id}`),
    ),
  ),
};

const linkLabels: Record<string, string> = {
  pricing: 'pricing',
  status: 'status',
  terms: 'terms',
  docs: 'docs',
};

// Pages the provider operates: the product, and the terms it is sold under.
// Where it posts is a different kind of link and sits on its own line.
const outgoing = [
  ...Object.entries(linkLabels)
    .filter(([key]) => data.urls?.[key as keyof typeof data.urls])
    .map(([key, label]) => ({ label, url: data.urls![key as keyof typeof data.urls] as string, field: 'urls' })),
  ...(data.sustainabilityUrl
    ? [{ label: 'sustainability', url: data.sustainabilityUrl, field: 'sustainabilityUrl' }]
    : []),
];

const { notes, numberOf } = footnotes(data.sources);

/* Groups as the component draws them: labels, resolved cells, and the source behind each row. */
const drawn = (groups: { label: string; fields: Field[] }[]) =>
  groups.map((group) => ({
    label: group.label,
    rows: group.fields.map((field) => ({
      label: field.label,
      cells: cells(field, valueOf(field.id), context),
      note: numberOf.get(field.id),
    })),
  }));

const related = backlinks(everyRecord as never, provider.id);

/*
 * A marker goes on the link it backs. Collected at the end of the row it was a
 * number floating after four links, backing whichever one the reader guessed —
 * and the sustainability claim is the one most worth citing precisely.
 *
 * Social accounts are not cited: a profile link either resolves to the provider
 * or it does not.
 */
const noteFor = (field: string) => numberOf.get(field);

/*
 * What each source backs, in the words the page uses for it. A source may name
 * no field at all — a claim made in the prose, cited inline — so anything
 * unmatched falls back to a readable form of the key rather than being dropped:
 * a source list that hides its own entries is worse than one with an unfamiliar
 * word in it.
 */
const sourceLabel = (field: string) =>
  fieldOf.get(field)?.label ??
  { notes: 'the notes', urls: 'links', social: 'accounts', sustainabilityUrl: 'sustainability' }[field] ??
  field.replace(/([A-Z])/g, ' $1').toLowerCase();

const origin = Astro.site?.origin ?? '';

/*
 * Accounts, as the identifiers schema.org means by sameAs — plus the Wikidata
 * item where one is recorded. A social handle says the company is present
 * somewhere; the Wikidata id says which company it is, which is the part that
 * lets anything else resolve this record against what it already knows.
 */
const social = [
  ...(data.wikidata ? [`https://www.wikidata.org/wiki/${data.wikidata}`] : []),
  ...Object.values(data.social ?? {}).filter((url): url is string => typeof url === 'string'),
];

// The policy page promises staleness is computed from the recorded date rather
// than from a promise to re-check. This is where that is kept.
const staleAfterDays = 180;
const checkedDaysAgo = data.checkedAt ? Math.floor((Date.now() - data.checkedAt.getTime()) / 86_400_000) : undefined;
const stale = checkedDaysAgo !== undefined && checkedDaysAgo > staleAfterDays;

/* The scope test, in the order /about/ numbers it. */
const criteria: Record<number, string> = {
  1: 'runs an application, or serves a site',
  2: 'sold to the public',
  3: 'public pricing',
  4: 'public technical documentation',
  5: 'twelve months old',
  6: 'two independent artifacts',
};

const statusNotice: Record<string, string> = {
  draft: 'This is a stub, missing details. It is not in the register and not counted.',
  acquired: 'Acquired, still operating.',
  renamed: 'Renamed. Same service under a new name.',
  'winding-down': 'Winding down: an end of life has been announced.',
  discontinued: 'Discontinued. This hosting providers does not operate any more.',
  unverifiable: 'Basic facts can no longer be confirmed from public sources.',
  'delisted-on-request': 'The provider asked to be removed. The record stays; entries are never deleted.',
};

const listed = isListed(provider);

/*
 * Built rather than looked up, because it has to name the criterion: "not
 * listed" without one is an assertion, and this page is where the decision is
 * argued with.
 */
const outOfScope =
  data.status === 'out-of-scope' && data.criterion
    ? `Not listed. Fails criterion ${data.criterion} — ${criteria[data.criterion]}${
        data.boundedSearch ? ', recorded as a bounded search rather than as proof of absence' : ''
      }. Being out of scope is not a criticism and most of these are reversible: bring the missing evidence and the record goes in.`
    : undefined;

const notice = outOfScope ?? (typeof data.status === 'string' ? statusNotice[data.status] : undefined);
---

<Base
  title={`${data.name} — FindHost`}
  description={data.description}
  markdown={`/${provider.id}.md`}
  hidden={!listed}
  image={cardPath(provider.id)}
  imageAlt={`A FindHost card for ${data.name}.`}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url: `${origin}/${provider.id}/`,
    publisher: organization(origin),
    /* The date somebody read the provider's own pages — the only one we stand behind. */
    ...(data.checkedAt ? { dateModified: new Date(data.checkedAt).toISOString().slice(0, 10) } : {}),
    license: 'https://creativecommons.org/licenses/by/4.0/',
    /* The same disclosure the page carries, for a reader that only parses schema. */
    ...(data.publishedByUs
      ? { disambiguatingDescription: 'This record is published by fortrabbit, which is also its subject.' }
      : {}),
    /*
     * The provider is the subject of the page, not its author. `about` says that
     * without claiming the page is theirs, and everything in it is a field on
     * the record — nothing is asserted here that the page does not show.
     */
    about: {
      '@type': 'Organization',
      name: data.name,
      ...(data.urls?.home ? { url: data.urls.home } : {}),
      ...(data.founded ? { foundingDate: String(data.founded) } : {}),
      ...(data.hqCountry ? { address: { '@type': 'PostalAddress', addressCountry: String(data.hqCountry) } } : {}),
      ...(social.length ? { sameAs: social } : {}),
    },
  }}
>
  <article>
    <h1>{data.name}</h1>
    {
      stale && (
        <aside class="editorial-note">
          <p>
            <strong>May be out of date.</strong> Last checked {checkedDaysAgo} days ago.
          </p>
        </aside>
      )
    }

    {
      /*
       * The one claim on a record page made in our own voice, and the disclosure
       * the register owes its reader. It hangs off `publishedByUs` rather than
       * off the heart beside it: a favorite is an opinion we could withdraw, and
       * this is a fact about who publishes the page. Above the description,
       * because a reader has to know whose account this is before reading it.
       */
      data.publishedByUs && (
        <aside class="editorial-note">
          <p>
            <strong>Published by us.</strong> FindHost is published by fortrabbit, so this record is our own —{' '}
            <a href="/about/#publisher">what that means</a>.
          </p>
        </aside>
      )
    }

    {
      data.description && (
        <p class="lead" data-pagefind-meta="summary">
          {data.description}
        </p>
      )
    }

    <p class="record-links">
      {/* Absent only where the provider has stopped and the domain went with it. */}
      {
        data.urls?.home && (
          <span class="record-link">
            <a class="record-home" href={data.urls.home} rel="nofollow">
              {data.urls.home.replace('https://', '')}
            </a>
            {noteFor('urls') && (
              <a class="footnote-ref" href={`#source-${noteFor('urls')}`} aria-label={`Source ${noteFor('urls')}`}>
                {noteFor('urls')}
              </a>
            )}
          </span>
        )
      }
      {
        outgoing.map((link) => (
          <span class="record-link">
            <a href={link.url} rel="nofollow">
              {link.label}
            </a>
            {/* `urls` is cited once, on the address; every page under it is the same source. */}
            {link.field !== 'urls' && noteFor(link.field) && (
              <a
                class="footnote-ref"
                href={`#source-${noteFor(link.field)}`}
                aria-label={`Source ${noteFor(link.field)}`}
              >
                {noteFor(link.field)}
              </a>
            )}
          </span>
        ))
      }
    </p>

    <SocialLinks social={data.social} />

    <PageFigure figure={data.figure} />

    {
      /*
       * Ours, said in the same breath as the mark that stands for it. The heart
       * is the badge the lists carry, so a reader who has seen one there knows
       * what this is before reading the sentence.
       */
      data.favorite && data.favoriteNote && (
        <p class="favorite-note full-bleed">
          <span class="record-badge favorite-badge" aria-hidden="true">
            ♥
          </span>
          <span class="favorite-words">{data.favoriteNote}</span>
          <a class="favorite-why" href="/about/#favorite-records" title="What a heart means here">
            <Fragment set:html={infoIcon} />
            <span class="visually-hidden">What a heart means here</span>
          </a>
        </p>
      )
    }

    <div class="record-layout">
      <aside class="record-specs">
        {
          /*
           * Why this record is not in the register, read as one of the recorded
           * facts rather than as a boxed warning above the page. It is the first
           * thing the record answers, and the box gave it a weight the sentence
           * does not need: being out of scope is a ruling, not an alarm.
           */
          notice && (
            <div class="fact-groups">
              <section class="fact-group">
                <h2>Status</h2>
                <p>{notice}</p>
              </section>
            </div>
          )
        }

        <FactGroups groups={drawn(nearGroups)} />

        {/* Facts about this record held on other records, drawn from their side of the relation. */}
        {related.length > 0 && <FactGroups groups={[{ label: 'Related', rows: related }]} />}

        {/* What this one says it does not sell, and where the register keeps the companies that do. */}
        {
          alsoNeeded.length > 0 && (
            <section class="fact-group">
              <h2>Also needed</h2>
              <ul class="also-needed">
                {alsoNeeded.map((pair) => (
                  <li>
                    {pair.need} — <a href={`/categories/${pair.category}/`}>who sells it</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          missing.length > 0 && (
            <details class="missing-fields">
              <summary>
                {missing.length} of {total} fields not recorded yet
              </summary>
              <p class="missing-list">{missing.map((field) => field.label).join(', ')}</p>
            </details>
          )
        }
      </aside>

      <div class="record-prose">
        <Content />

        {
          data.caveat && (
            <aside class="caveat">
              <p>
                <span aria-hidden="true">{data.caveat.emoji}</span> {data.caveat.text}
              </p>
              <p class="caveat-source">
                A judgement by {data.caveat.by}, {data.caveat.on.toISOString().slice(0, 10)}. Not a filterable field.
              </p>
            </aside>
          )
        }
      </div>
    </div>

    {farGroups.length > 0 && <FactGroups groups={drawn(farGroups)} class="record-extra" />}

    {
      notes.length > 0 && (
        <section class="sources">
          <h2>Sources</h2>
          <ol>
            {notes.map((note, index) => (
              <li id={`source-${index + 1}`}>
                <span class="source-date">{note.checkedAt.toISOString().slice(0, 10)}</span>:&nbsp;
                <span class="source-fields">{note.fields.map(sourceLabel).join(', ')}</span>
                <br />
                <a href={note.url} rel="nofollow">
                  {note.url.replace('https://', '')}
                </a>{' '}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <p class="annotation">
      {data.checkedAt ? `Last reviewed ${data.checkedAt.toISOString().slice(0, 10)}. ` : 'Never checked. '}
      <br />
      <a href={`https://github.com/fortrabbit/findhost/edit/main/src/content/providers/${provider.id}.md`}>
        Complete this record.
      </a>
    </p>
  </article>
</Base>
