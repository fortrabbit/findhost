---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProviderList from '../components/ProviderList.astro';
import WorldMap from '../components/WorldMap.astro';
import { loadFacets } from '../lib/facets';

// Alphabetical, always. The default sort is deterministic and content-independent,
// and completeness never affects order.
const records = (await getCollection('providers')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'en'));

const providers = records.map((provider) => ({
  id: provider.id,
  name: provider.data.name,
  description: provider.data.description,
  publishedByUs: provider.data.publishedByUs,
  greenWebId: provider.data.greenWebId,
}));

const { facets } = await loadFacets();

// "What do I need to run" is the first question anyone actually asks, so it is
// the first thing on the page — as links to pages that already exist.
const runtimes = (facets.find((facet) => facet.id === 'runtimes')?.values ?? []).filter((value) => value.count > 0);
const software = (facets.find((facet) => facet.id === 'software')?.values ?? []).filter((value) => value.count > 0);
const categories = (facets.find((facet) => facet.id === 'category')?.values ?? []).filter((value) => value.count > 0);

const regions = records.flatMap((provider) => provider.data.regions ?? []);
const placed = records.filter((provider) => provider.data.regions?.length).length;
---

<Base
  title="FindHost — a ratings-free dataset of hosting providers"
  description="Every provider that meets the scope test, described by attributes rather than scores."
  ai="co-authored"
>
  <h1>Find your next hosting provider</h1>

  <p class="lede">
    Don't shop hosting by horse power and price only. Understand what really matters. A developer-friendly, opinionated
    field guide to choose the right hosting provider.
  </p>

  <h2>I want to host…</h2>

  {
    software.length > 0 && (
      <ul class="entry-list">
        {software.map((entry) => (
          <li>
            <a href={`/software/${entry.id}/`}>{entry.label}</a>
            <span class="entry-count">{entry.count}</span>
          </li>
        ))}
      </ul>
    )
  }

  <h2>…or anything written in…</h2>

  <ul class="entry-list">
    {
      runtimes.map((runtime) => (
        <li>
          <a href={`/runtimes/${runtime.id}/`}>{runtime.label}</a>
          <span class="entry-count">{runtime.count}</span>
        </li>
      ))
    }
  </ul>

  <h2>…on this kind of platform</h2>

  <ul class="entry-list">
    {
      categories.map((category) => (
        <li>
          <a href={`/category/${category.id}/`}>{category.label}</a>
          <span class="entry-count">{category.count}</span>
        </li>
      ))
    }
  </ul>

  <h2>…in a place you choose</h2>

  <WorldMap regions={regions} weighted label="Countries the providers in this dataset operate in" />

  <p class="annotation">
    {placed} of {providers.length} records say where they operate. <a href="/map/">See the map in full</a>, or <a
      href="/providers/">combine regions with everything else</a
    >.
  </p>

  <h2>{providers.length} providers</h2>

  <p class="annotation">Sorted alphabetically.</p>

  <ProviderList providers={providers} />
</Base>
