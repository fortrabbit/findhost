---
import Base from '../layouts/Base.astro';
import ProviderRegister from '../components/ProviderRegister.astro';
import FindFilters from '../components/FindFilters.astro';
import { loadDefunct, loadDrafts, loadFacets } from '../lib/facets';

const { facets, providers } = await loadFacets();
const drafts = await loadDrafts();
const defunct = await loadDefunct();
---

{
  /*
   * The register is the homepage. What stood here before was a page of links to
   * the register, which asked a visitor to choose a way in before seeing that
   * there was anything to come in to. The filter panel carries the same links —
   * every facet title is one — and it carries the records with them.
   */
}
<Base
  title="FindHost — a ratings-free dataset of hosting providers"
  description="Opinionated field guide to choose the right hosting provider."
>
  <h1>Find your next web host</h1>

  <!-- <p class="lead">
    An <a href="/about/" title="About">opinionated</a>{' '}
    <a href="/guide/">hosting guide</a>.
  </p> -->

  <ProviderRegister providers={providers} facets={facets}>
    <FindFilters facets={facets} drafts={drafts.length} defunct={defunct.length} />
  </ProviderRegister>
</Base>

<!-- The register is the one page that filters, so it is the one page that ships the script. -->
<script>
  import '../scripts/find.ts';
</script>
