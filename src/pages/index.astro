---
import Base from '../layouts/Base.astro';
import ProviderRegister from '../components/ProviderRegister.astro';
import FindFilters from '../components/FindFilters.astro';
import { besideTheRegister, loadFacets, registerLists } from '../lib/facets';
import { loadIndexed } from '../lib/providers';
import { fieldOf, fields } from '../lib/fields';
import { dataset } from '../lib/seo';
import { modifiedAt, newest } from '../lib/modified';

const { facets, providers } = await loadFacets();

/*
 * The newest date anybody read a provider's own pages, which is what the Dataset
 * markup reports as `dateModified`. Freshness is the claim this register can
 * make and a commission-ordered table cannot, so it is stated where a machine
 * finds it without reading prose.
 */
const indexed = await loadIndexed();
const lastChecked = newest(indexed.map((provider) => modifiedAt(provider.data)));

/* The day the register first held a record, for the Dataset's `datePublished`, over the same records. */
const firstAdded = indexed
  .map((provider) => provider.data.addedAt?.getTime())
  .filter((time): time is number => time !== undefined)
  .sort((a, b) => a - b)[0];

/* The categories some record holds, as the words somebody looking for this dataset would use. */
const held = new Set(providers.flatMap((provider) => provider.facets.category ?? []));
const keywords = (fieldOf.get('category')?.values ?? [])
  .filter((value) => held.has(value.id))
  .map((value) => value.label);

const registers = await registerLists();

/*
 * The groups the panel does not offer as a list of its own: they stay in the
 * sentence over the register, which is where a reader asks what happened to a
 * host rather than what to buy.
 */
const offered = new Set(registers.map((register) => register.key));
const beside = (await besideTheRegister()).filter((group) => !offered.has(group.key));
---

{
  /*
   * The register is the homepage: the filter panel already carries every facet
   * link, so a landing page of ways in would only withhold the records.
   */
}
<Base
  title="FindHost — a register of web hosting providers"
  description="Web hosting providers recorded field by field, with a source for every answer. Filter by runtime, region or price. No scores, rankings or affiliate links."
  schema={[
    dataset(Astro.site?.origin ?? '', providers.length, {
      fields,
      modified: lastChecked,
      published: firstAdded === undefined ? undefined : new Date(firstAdded),
      keywords,
    }),
  ]}
>
  <h1>Find your next web host</h1>

  <ProviderRegister providers={providers} facets={facets} beside={beside} registers={registers} sort="name">
    <FindFilters facets={facets} providers={providers} registers={registers} />
  </ProviderRegister>
</Base>

<!-- The register is the one page that filters, so it is the one page that ships the script. -->
<script>
  import '../scripts/find.ts';
</script>
