---
import Base from '../layouts/Base.astro';
import ProviderRegister from '../components/ProviderRegister.astro';
import FindFilters from '../components/FindFilters.astro';
import { besideTheRegister, loadFacets } from '../lib/facets';
import { loadIndexed } from '../lib/providers';
import { fields } from '../lib/fields';
import { dataset, website } from '../lib/seo';
import { modifiedAt, newest } from '../lib/modified';

const { facets, providers } = await loadFacets();

/*
 * The newest date anybody read a provider's own pages, which is what the Dataset
 * markup reports as `dateModified`. Freshness is the claim this register can
 * make and a commission-ordered table cannot, so it is stated where a machine
 * finds it without reading prose.
 */
const lastChecked = newest((await loadIndexed()).map((provider) => modifiedAt(provider.data)));

const beside = await besideTheRegister();
---

{
  /*
   * The register is the homepage: the filter panel already carries every facet
   * link, so a landing page of ways in would only withhold the records.
   */
}
<Base
  title="FindHost — a register of web hosting providers"
  description="Opinionated field guide to choosing a web host."
  schema={[
    dataset(Astro.site?.origin ?? '', providers.length, { fields, modified: lastChecked }),
    website(Astro.site?.origin ?? ''),
  ]}
>
  <h1>Find your next web host</h1>

  <ProviderRegister providers={providers} facets={facets} beside={beside} sort="name">
    <FindFilters facets={facets} providers={providers} />
  </ProviderRegister>
</Base>

<!-- The register is the one page that filters, so it is the one page that ships the script. -->
<script>
  import '../scripts/find.ts';
</script>
