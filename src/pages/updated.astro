---
import Base from '../layouts/Base.astro';
import ProviderRegister from '../components/ProviderRegister.astro';
import FindFilters from '../components/FindFilters.astro';
import { asideGroups, loadFacets } from '../lib/facets';

/*
 * The register in the order it was last read: the same rows, the same filters,
 * grouped by the month a record was last checked against the provider's own
 * pages. `checkedAt` is the one date this project stands behind, which is why
 * this order exists and a "last edited" one does not.
 */
const { facets, providers } = await loadFacets();

const beside = (await asideGroups()).map((group) => ({
  label: group.label,
  href: `/${group.key}/`,
  count: group.rows.length,
}));
---

<Base
  title="Last updated — FindHost"
  description="Every hosting provider in the register, in the order its record was last checked against the provider's own pages."
>
  <h1>Last updated</h1>

  <p class="annotation">
    The register, newest check first: the month under which a record sits is when it was last read against the
    provider's own pages. A record nobody has checked yet sits at the end, and says so.
  </p>

  <ProviderRegister providers={providers} facets={facets} beside={beside} sort="updated">
    <FindFilters facets={facets} providers={providers} />
  </ProviderRegister>
</Base>

<script>
  import '../scripts/find.ts';
</script>
