---
import Base from '../layouts/Base.astro';
---

<Base title="Search — FindHost" description="Search every provider record and guide page." ai="co-authored">
  <h1>Search</h1>

  <p class="lede">
    Free text across every record and every guide page. To filter by runtime, region or ownership instead,
    <a href="/find/">use find</a> — search reads words, find reads fields.
  </p>

  <form class="site-search" data-search-form>
    <input type="search" name="q" placeholder="Search providers and guide" aria-label="Search" data-search-input />
    <button type="submit">Search</button>
  </form>

  <p class="annotation" data-search-summary>Type a word or two.</p>

  <ul class="provider-list" data-search-results></ul>

  <script>
    import '../scripts/search.ts';
  </script>
</Base>
