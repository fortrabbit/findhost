---
import Base from '../layouts/Base.astro';
import ProviderRegister from '../components/ProviderRegister.astro';
import FindFilters from '../components/FindFilters.astro';
import { besideTheRegister, loadFacets } from '../lib/facets';

/*
 * The register in the order it grew: the same rows, the same filters, newest
 * record first. A date about the register rather than the provider — a host
 * founded in 1999 and added last month is a recent record.
 */
const { facets, providers } = await loadFacets();

const beside = await besideTheRegister();
---

<Base title="Added — FindHost" description="Every hosting provider in the register, in the order its record was added.">
  <h1>Added</h1>

  <p class="annotation">
    The register, newest record first. When a record entered the register says nothing about how old the provider is;
    the date is on each record.
  </p>

  <ProviderRegister providers={providers} facets={facets} beside={beside} sort="added">
    <FindFilters facets={facets} providers={providers} />
  </ProviderRegister>
</Base>

<script>
  import '../scripts/find.ts';
</script>
