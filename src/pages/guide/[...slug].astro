---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageFigure from '../../components/PageFigure.astro';

export async function getStaticPaths() {
  const pages = await getCollection('guide');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Base title={`${page.data.title} — FindHost`} description={page.data.description}>
  <article>
    <h1>{page.data.title}</h1>
    {page.data.lead && <p class="lead">{page.data.lead}</p>}
    <PageFigure figure={page.data.figure} />
    <Content />
  </article>
</Base>
