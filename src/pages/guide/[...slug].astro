---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuideNav from '../../components/GuideNav.astro';

export async function getStaticPaths() {
  const pages = await getCollection('guide');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Base title={`${page.data.title} — FindHost`} description={page.data.description} ai={page.data.ai}>
  {
    /* Outside the grid: a band that bleeds to both page edges cannot be measured from inside a column. */
    page.data.figure && (
      <p
        class="figure-band full-bleed"
        style={`background:${page.data.figure.color};color:${page.data.figure.textColor}`}
      >
        <span aria-hidden="true">{page.data.figure.emoji}</span> {page.data.figure.text}
      </p>
    )
  }

  <div class="guide-layout full-width">
    <GuideNav current={`/guide/${page.id}/`} />

    <article>
      <h1>{page.data.title}</h1>
      {page.data.lead && <p class="lead">{page.data.lead}</p>}

      <Content />
    </article>
  </div>
</Base>
