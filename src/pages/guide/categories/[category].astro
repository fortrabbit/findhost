---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { loadFacets } from '../../../lib/facets';
import GuideNav from '../../../components/GuideNav.astro';

/*
 * A category is described here and listed at /category/<id>/. Two pages, one
 * job each: this one is read, that one is scanned. The explainer used to sit on
 * top of the list, which made the list page long before it showed a single
 * provider and left the guide with a second, shorter description of the same
 * eight things.
 */
export async function getStaticPaths() {
  const explainers = await getCollection('categories');
  const { facets } = await loadFacets();
  const category = facets.find((facet) => facet.id === 'category');

  return explainers.map((explainer) => ({
    params: { category: explainer.id },
    props: {
      explainer,
      count: category?.values.find((value) => value.id === explainer.id)?.count ?? 0,
    },
  }));
}

const { explainer, count } = Astro.props;
const { Content } = await render(explainer);

const listed = `${count} ${count === 1 ? 'provider' : 'providers'}`;
---

<Base title={`${explainer.data.title} — FindHost`} description={explainer.data.description} ai={explainer.data.ai}>
  {
    explainer.data.figure && (
      <p
        class="figure-band full-bleed"
        style={`background:${explainer.data.figure.color};color:${explainer.data.figure.textColor}`}
      >
        <span aria-hidden="true">{explainer.data.figure.emoji}</span> {explainer.data.figure.text}
      </p>
    )
  }

  <div class="guide-layout full-width">
    <GuideNav current={`/guide/categories/${explainer.id}/`} />

    <article>
      <h1>{explainer.data.title}</h1>
      {explainer.data.lead && <p class="lead">{explainer.data.lead}</p>}

      <Content />

      <p class="show-all">
        <a href={`/category/${explainer.id}/`}>See the {listed} in this category →</a>
      </p>
    </article>
  </div>
</Base>
