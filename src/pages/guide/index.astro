---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const pages = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Guide — FindHost"
  description="The cross-cutting explainers: why the market is opaque, and what to look at instead."
>
  <h1>Guide</h1>

  <p class="lead">How to choose and not choose a hosting provider.</p>

  <ul class="stack-list">
    {
      pages.map((page) => (
        <li>
          <a href={`/guide/${page.id}/`}>{page.data.title}</a>
          {page.data.description && <p>{page.data.description}</p>}
        </li>
      ))
    }
  </ul>
</Base>
