---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { loadFacets } from '../../lib/facets';
import WorldMap from '../../components/WorldMap.astro';
import { coins, energy, flag, footnotes, price } from '../../lib/record';

export async function getStaticPaths() {
  const providers = await getCollection('providers');
  return providers.map((provider) => ({
    params: { id: provider.id },
    props: { provider },
  }));
}

const { provider } = Astro.props;

// Facet values must reach the markup even where the design does not show them:
// Pagefind indexes rendered HTML, so what is absent here cannot be searched later.
const { facets } = await loadFacets();
const facetByField = new Map(facets.map((facet) => [facet.field, facet]));
const { Content } = await render(provider);
const data = provider.data;

const countryNames = new Map(
  (facets.find((facet) => facet.id === 'regions')?.values ?? []).map((value) => [value.id, value.label]),
);

// Fields describing the provider. Meta and provenance are excluded — they
// describe our work, not the provider, so they do not belong in the denominator.
type Attribute = [label: string, key: string, value: unknown, facet?: string];

const attributeGroups: { label: string; fields: Attribute[] }[] = [
  {
    label: 'Identity',
    fields: [
      ['Founded', 'founded', data.founded],
      ['Headquarters', 'hqCountry', data.hqCountry],
      ['Ownership', 'ownership', data.ownership, 'ownership'],
      ['Parent', 'parent', data.parent],
      ['Status', 'status', data.status],
    ],
  },
  {
    label: 'Classification',
    fields: [
      ['Category', 'category', data.category, 'category'],
      ['Also offers', 'alsoOffers', data.alsoOffers, 'alsoOffers'],
      ['Manages the OS', 'whoManagesOs', data.whoManagesOs, 'whoManagesOs'],
      ['Hardware', 'infraContract', data.infraContract, 'infraContract'],
      ['Runs on', 'runsOn', data.runsOn],
      ['Built for', 'useCases', data.useCases, 'useCases'],
      ['Sold to', 'audience', data.audience, 'audience'],
    ],
  },
  {
    label: 'Tech stack',
    fields: [
      ['Runtimes', 'runtimes', data.runtimes, 'runtimes'],
      ['Runs', 'software', data.software, 'software'],
      ['Specialised in', 'specialisation', data.specialisation],
      ['Deploy methods', 'deployMethods', data.deployMethods],
      ['SSH access', 'sshAccess', data.sshAccess, 'sshAccess'],
      ['Managed databases', 'managedDatabases', data.managedDatabases],
      ['Persistent storage', 'persistentStorage', data.persistentStorage],
      ['Backups', 'backupsIncluded', data.backupsIncluded],
    ],
  },
  {
    label: 'Pricing',
    fields: [
      ['Pricing model', 'pricingModel', data.pricingModel],
      ['Entry price', 'entryPriceBand', data.entryPriceBand, 'entryPriceBand'],
      ['Renewal multiple', 'renewalMultiple', data.renewalMultiple],
      ['Free tier', 'freeTier', data.freeTier, 'freeTier'],
      ['Minimum contract', 'contractMinimum', data.contractMinimum],
    ],
  },
  {
    label: 'Regions and law',
    fields: [
      ['Regions', 'regions', data.regions, 'regions'],
      ['DPA', 'gdprDpa', data.gdprDpa],
    ],
  },
  {
    label: 'Environment',
    fields: [
      ['Energy claim', 'energyClaim', data.energyClaim],
      ['PUE', 'pue', data.pue],
      ['Certifications', 'certifications', data.certifications],
      ['Carbon report', 'carbonReport', data.carbonReport],
      ['Green Web directory', 'greenWebId', data.greenWebId],
    ],
  },
  {
    label: 'Support',
    fields: [
      ['Channels', 'supportChannels', data.supportChannels],
      ['Hours', 'supportHours', data.supportHours],
      ['Tiering', 'supportTiering', data.supportTiering],
    ],
  },
  {
    label: 'Openness',
    fields: [
      ['Data export', 'dataExport', data.dataExport],
      ['Lock-in', 'proprietaryLockIn', data.proprietaryLockIn],
    ],
  },
  {
    label: 'Automation',
    fields: [
      ['API', 'apiAvailable', data.apiAvailable],
      ['CLI', 'cliTool', data.cliTool],
      ['MCP server', 'mcpServer', data.mcpServer, 'mcpServer'],
      ['Infrastructure as code', 'iacSupport', data.iacSupport],
      ['Agent-readable docs', 'agentReadyDocs', data.agentReadyDocs],
    ],
  },
];

const held = (value: unknown) =>
  value !== undefined && value !== null && (!Array.isArray(value) || value.length > 0);

// Known first. What is missing is named once, together, where it reads as an
// ask rather than as forty rows of `?`.
const knownGroups = attributeGroups
  .map((group) => ({ label: group.label, fields: group.fields.filter(([, , value]) => held(value)) }))
  .filter((group) => group.fields.length > 0);

const missing = attributeGroups.flatMap((group) => group.fields).filter(([, , value]) => !held(value));
const total = attributeGroups.flatMap((group) => group.fields).length;

const linkLabels: Record<string, string> = {
  pricing: 'pricing',
  status: 'status',
  terms: 'terms',
  sla: 'SLA',
  docs: 'docs',
};

const socialLabels: Record<string, string> = {
  x: 'X',
  bluesky: 'Bluesky',
  mastodon: 'Mastodon',
  linkedin: 'LinkedIn',
  github: 'GitHub',
  facebook: 'Facebook',
  youtube: 'YouTube',
  discord: 'Discord',
};

// Pages the provider operates and accounts it posts from are all routes off this
// page to the provider, so they share one line.
const outgoing = [
  ...Object.entries(linkLabels)
    .filter(([key]) => data.urls[key as keyof typeof data.urls])
    .map(([key, label]) => [label, data.urls[key as keyof typeof data.urls] as string] as const),
  ...Object.entries(data.social ?? {})
    .filter(([, url]) => url)
    .map(([key, url]) => [socialLabels[key] ?? key, url as string] as const),
];

const { notes, numberOf } = footnotes(data.sources);

const entryPrice = price(data.entryPrice);
const entryCoins = coins(data.entryPriceBand);
const energyClaim = energy(data.energyClaim);
const homeFlag = flag(data.hqCountry);

// The policy page promises staleness is computed from the recorded date rather
// than from a promise to re-check. This is where that is kept.
const staleAfterDays = 180;
const checkedDaysAgo = data.checkedAt ? Math.floor((Date.now() - data.checkedAt.getTime()) / 86_400_000) : undefined;
const stale = checkedDaysAgo !== undefined && checkedDaysAgo > staleAfterDays;

const statusNotice: Record<string, string> = {
  acquired: 'Acquired, still operating.',
  renamed: 'Renamed. Same service under a new name.',
  'winding-down': 'Winding down: an end of life has been announced.',
  discontinued: 'Discontinued. The facts below are the last ones known to be true.',
  unverifiable: 'Basic facts can no longer be confirmed from public sources.',
  'delisted-on-request': 'The provider asked to be removed. The record stays; entries are never deleted.',
};

const notice = typeof data.status === 'string' ? statusNotice[data.status] : undefined;

const format = (value: unknown) => {
  if (Array.isArray(value)) return value.join(', ');
  if (typeof value === 'boolean') return value ? 'yes' : 'no';
  return String(value);
};
---

<Base
  title={`${data.name} — FindHost`}
  description={data.description}
  ai={data.ai}
  markdown={`/providers/${provider.id}.md`}
>
  <article>
    {
      data.figure && (
        <p class="figure-band full-bleed" style={`background:${data.figure.color};color:${data.figure.textColor}`}>
          <span aria-hidden="true">{data.figure.emoji}</span> {data.figure.text}
        </p>
      )
    }

    <h1>{data.name}</h1>
    {data.publishedByUs && <p class="annotation">This is us. We publish this site and we appear in its dataset.</p>}

    {
      notice && (
        <aside class="editorial-note">
          <p>
            <strong>Status.</strong> {notice}
          </p>
        </aside>
      )
    }

    {
      stale && (
        <aside class="editorial-note">
          <p>
            <strong>May be out of date.</strong> Last checked {checkedDaysAgo} days ago. Everything below was true then
            and has not been confirmed since.
          </p>
        </aside>
      )
    }

    {data.description && <p class="lead">{data.description}</p>}

    <p class="record-links">
      <a href={data.urls.home} rel="nofollow">{data.urls.home.replace('https://', '')}</a>
      {
        outgoing.map(([label, url]) => (
          <>
            {' · '}
            <a href={url} rel="nofollow">
              {label}
            </a>
          </>
        ))
      }
    </p>

    {
      (homeFlag || entryCoins || energyClaim) && (
        <p class="record-strip">
          {homeFlag && (
            <span class="strip-item">
              <span aria-hidden="true">{homeFlag}</span> {countryNames.get(data.hqCountry!) ?? data.hqCountry}
            </span>
          )}
          {entryCoins && (
            <span class="strip-item">
              <span class="coins">{entryCoins}</span>
              {entryPrice && <span class="strip-detail">{entryPrice}</span>}
            </span>
          )}
          {energyClaim && (
            <span class="strip-item">
              <span aria-hidden="true">🌱</span> {energyClaim}
            </span>
          )}
        </p>
      )
    }

    <div class="fact-groups full-width">
      {
        knownGroups.map((group) => (
          <section class="fact-group">
            <h3>{group.label}</h3>
            <dl class="fact-list">
              {group.fields.map(([label, key, value, field]) => {
                const facet = field ? facetByField.get(field) : undefined;
                const values = Array.isArray(value) ? value : [value];
                const note = numberOf.get(key);

                return (
                  <>
                    <dt>{label}</dt>
                    <dd>
                      {facet
                        ? values.map((entry, index) => (
                            <>
                              {index > 0 && ', '}
                              <a href={`/${facet.id}/${entry}/`} data-pagefind-filter={facet.id}>
                                {key === 'entryPriceBand' ? coins(String(entry)) : String(entry)}
                              </a>
                            </>
                          ))
                        : format(value)}
                      {note && (
                        <a class="footnote-ref" href={`#source-${note}`} aria-label={`Source ${note}`}>
                          {note}
                        </a>
                      )}
                    </dd>
                  </>
                );
              })}
            </dl>
          </section>
        ))
      }
    </div>

    {
      missing.length > 0 && (
        <details class="missing-fields">
          <summary>
            {missing.length} of {total} fields not recorded yet
          </summary>
          <p class="missing-list">{missing.map(([label]) => label).join(' · ')}</p>
          <p>
            <a href="https://github.com/fortrabbit/findhost">Know one of these? Edit this record.</a>
          </p>
        </details>
      )
    }

    {
      notes.length > 0 && (
        <section class="sources">
          <h2>Sources</h2>
          <ol>
            {notes.map((note, index) => (
              <li id={`source-${index + 1}`}>
                <span class="source-fields">{note.fields.join(', ')}</span> —{' '}
                <a href={note.url} rel="nofollow">
                  {note.url.replace('https://', '')}
                </a>{' '}
                <span class="source-date">read {note.checkedAt.toISOString().slice(0, 10)}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      data.regions?.length && (
        <>
          <h2>Where it operates</h2>
          <WorldMap regions={data.regions} label={`Countries ${data.name} operates in`} />
        </>
      )
    }

    <Content />

    {
      data.caveat && (
        <aside class="caveat">
          <p>
            <span aria-hidden="true">{data.caveat.emoji}</span> {data.caveat.text}
          </p>
          <p class="caveat-source">
            A judgement by {data.caveat.by}, {data.caveat.on.toISOString().slice(0, 10)}. Not a filterable field.
          </p>
        </aside>
      )
    }

    {
      data.editorialNote && (
        <aside class="editorial-note">
          <p>
            <strong>Disclosure.</strong> {data.editorialNote}
          </p>
        </aside>
      )
    }

    <p class="annotation">
      {total - missing.length} of {total} attributes recorded.
      {data.checkedAt ? ` Last checked ${data.checkedAt.toISOString().slice(0, 10)}. ` : ' Never checked. '}
      <br />
      <a href="https://github.com/fortrabbit/findhost">Complete this record.</a>
    </p>
  </article>
</Base>
