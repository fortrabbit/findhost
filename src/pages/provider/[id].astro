---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { loadFacets } from '../../lib/facets';
import WorldMap from '../../components/WorldMap.astro';

export async function getStaticPaths() {
  const providers = await getCollection('providers');
  return providers.map((provider) => ({ params: { id: provider.id }, props: { provider } }));
}

const { provider } = Astro.props;

// Facet values must reach the markup even where the design does not show them:
// Pagefind indexes rendered HTML, so what is absent here cannot be searched later.
const { facets } = await loadFacets();
const facetByField = new Map(facets.map((facet) => [facet.field, facet]));
const { Content } = await render(provider);
const data = provider.data;

// Fields describing the provider. Meta and provenance are excluded — they
// describe our work, not the provider, so they do not belong in the denominator.
type Attribute = [label: string, value: unknown, field?: string];

const attributeGroups: { label: string; fields: Attribute[] }[] = [
  {
    label: 'Identity',
    fields: [
      ['Founded', data.founded],
      ['Headquarters', data.hqCountry],
      ['Ownership', data.ownership, 'ownership'],
      ['Parent', data.parent],
      ['Status', data.status],
    ],
  },
  {
    label: 'Classification',
    fields: [
      ['Category', data.category, 'category'],
      ['Also offers', data.alsoOffers, 'alsoOffers'],
      ['Manages the OS', data.whoManagesOs, 'whoManagesOs'],
      ['Hardware', data.infraContract, 'infraContract'],
      ['Runs on', data.runsOn],
    ],
  },
  {
    label: 'Tech stack',
    fields: [
      ['Runtimes', data.runtimes, 'runtimes'],
      ['Deploy methods', data.deployMethods],
      ['SSH access', data.sshAccess, 'sshAccess'],
      ['Managed databases', data.managedDatabases],
      ['Persistent storage', data.persistentStorage],
      ['Backups', data.backupsIncluded],
    ],
  },
  {
    label: 'Pricing',
    fields: [
      ['Pricing model', data.pricingModel],
      ['Entry price', data.entryPriceBand, 'entryPriceBand'],
      ['Renewal multiple', data.renewalMultiple],
      ['Free tier', data.freeTier, 'freeTier'],
      ['Minimum contract', data.contractMinimum],
    ],
  },
  {
    label: 'Regions and law',
    fields: [
      ['Regions', data.regions, 'regions'],
      ['DPA', data.gdprDpa],
    ],
  },
  {
    label: 'Environment',
    fields: [
      ['Energy claim', data.energyClaim],
      ['PUE', data.pue],
      ['Certifications', data.certifications],
      ['Carbon report', data.carbonReport],
      ['Green Web directory', data.greenWebId],
    ],
  },
  {
    label: 'Support',
    fields: [
      ['Channels', data.supportChannels],
      ['Hours', data.supportHours],
      ['Tiering', data.supportTiering],
    ],
  },
  {
    label: 'Openness',
    fields: [
      ['Data export', data.dataExport],
      ['Lock-in', data.proprietaryLockIn],
    ],
  },
  {
    label: 'Automation',
    fields: [
      ['API', data.apiAvailable],
      ['CLI', data.cliTool],
      ['MCP server', data.mcpServer, 'mcpServer'],
      ['Infrastructure as code', data.iacSupport],
      ['Agent-readable docs', data.agentReadyDocs],
    ],
  },
];

const format = (value: unknown) => {
  if (value === undefined || value === null) return '?';
  if (Array.isArray(value)) return value.length ? value.join(', ') : '?';
  if (typeof value === 'boolean') return value ? 'yes' : 'no';
  return String(value);
};

const total = attributeGroups.flatMap((group) => group.fields).length;
const known = attributeGroups
  .flatMap((group) => group.fields)
  .filter(([, value]) => format(value) !== '?').length;
---

<Base title={`${data.name} — FindHost`} description={data.description} ai={data.ai}>
  <article>
    <h1>{data.name}</h1>
    {data.publishedByUs && <p class="annotation">This is us. We publish this site and we appear in its dataset.</p>}

    {
      data.figure && (
        <p class="figure-band full-bleed" style={`background:${data.figure.color};color:${data.figure.textColor}`}>
          <span aria-hidden="true">{data.figure.emoji}</span> {data.figure.text}
        </p>
      )
    }

    {data.description && <p class="lede">{data.description}</p>}

    <p class="record-links">
      <a href={data.url} rel="nofollow">{data.url.replace('https://', '')}</a>
      {data.pricingUrl && <> · <a href={data.pricingUrl} rel="nofollow">pricing</a></>}
      {data.statusUrl && <> · <a href={data.statusUrl} rel="nofollow">status</a></>}
    </p>

    <Content />

    {
      data.caveat && (
        <aside class="caveat">
          <p>
            <span aria-hidden="true">{data.caveat.emoji}</span> {data.caveat.text}
          </p>
          <p class="caveat-source">
            A judgement by {data.caveat.by}, {data.caveat.on.toISOString().slice(0, 10)}. Not a filterable field.
          </p>
        </aside>
      )
    }

    {
      data.editorialNote && (
        <aside class="editorial-note">
          <p>
            <strong>Disclosure.</strong> {data.editorialNote}
          </p>
        </aside>
      )
    }

    {
      data.regions?.length && (
        <>
          <h2>Where it operates</h2>
          <WorldMap regions={data.regions} label={`Countries ${data.name} operates in`} />
        </>
      )
    }

    <h2>The record</h2>
    <p class="annotation">
      {known} of {total} attributes recorded. That is a fact about our work, not about {data.name} — it never affects
      sort order.
      {
        data.checkedAt
          ? ` Last checked ${data.checkedAt.toISOString().slice(0, 10)}.`
          : ' Never checked against the provider — no date is claimed.'
      }
    </p>

    <div class="fact-groups full-width">
      {
        attributeGroups.map((group) => (
          <section class="fact-group">
            <h3>{group.label}</h3>
            <dl class="fact-list">
              {group.fields.map(([label, value, field]) => {
                const facet = field ? facetByField.get(field) : undefined;
                const values = value === undefined || value === null ? [] : Array.isArray(value) ? value : [value];

                return (
                  <>
                    <dt>{label}</dt>
                    <dd>
                      {facet && values.length ? (
                        values.map((entry, index) => (
                          <>
                            {index > 0 && ', '}
                            <a href={`/${facet.id}/${entry}/`} data-pagefind-filter={facet.id}>
                              {String(entry)}
                            </a>
                          </>
                        ))
                      ) : (
                        format(value)
                      )}
                    </dd>
                  </>
                );
              })}
            </dl>
          </section>
        ))
      }
    </div>

    <p class="annotation">
      Something wrong or missing? <a href="https://github.com/fortrabbit/findhost">Complete this record.</a>
    </p>
  </article>
</Base>

