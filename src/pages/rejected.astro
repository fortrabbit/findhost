---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entries = (await getCollection('rejected')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'en'));

const criteria: Record<number, string> = {
  1: 'Runs application code',
  2: 'Sold to the public',
  3: 'Public pricing',
  4: 'Public technical documentation',
  5: 'Twelve months old',
  6: 'Two independent artifacts',
};

const rendered = await Promise.all(entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
---

<Base
  title="Not listed — FindHost"
  description="Providers that were considered and not listed, and which numbered criterion each one failed."
  ai="co-authored"
>
  <h1>Not listed</h1>

  <p class="lede">
    A scope test nobody can audit is not a scope test. Every provider that was considered and left out appears here with
    the numbered criterion it failed and the date it was checked.
  </p>

  <p class="annotation">
    Being out of scope is not a criticism, and most of these are reversible. Bring the missing evidence and the record
    goes in.
  </p>

  {
    rendered.map(({ entry, Content }) => (
      <section id={entry.id}>
        <h2>
          <a class="anchor-link" href={`#${entry.id}`} aria-label={`Link to ${entry.data.name}`}>
            #
          </a>
          {entry.data.name}
        </h2>

        <p class="annotation">
          Failed criterion {entry.data.criterion} — {criteria[entry.data.criterion]}. Checked{' '}
          {entry.data.checkedAt.toISOString().slice(0, 10)}.
          {entry.data.boundedSearch && ' Recorded as a bounded search rather than a proof of absence.'}
          {' · '}
          <a href={entry.data.url} rel="nofollow">
            {entry.data.url.replace('https://', '')}
          </a>
        </p>

        <Content />
      </section>
    ))
  }

  {entries.length === 0 && <p>Nothing has been rejected yet.</p>}
</Base>
