---
import Base from '../layouts/Base.astro';
import ProviderList from '../components/ProviderList.astro';
import { loadFacets } from '../lib/facets';

const { facets, providers } = await loadFacets();
---

<Base
  title="Find a provider — FindHost"
  description="Filter the dataset by runtime, region, ownership, price band and more."
  ai="co-authored"
>
  <h1>Find</h1>

  <p class="lede">
    Combine any of the {facets.length} facets. Filters narrow the list; nothing here reorders it, and a record is never ranked
    against another.
  </p>

  <p class="annotation" data-find-summary>
    {providers.length} {providers.length === 1 ? 'record' : 'records'}, sorted alphabetically.
  </p>

  <div class="find">
    <div class="find-filters" data-find-filters></div>
    <ul class="provider-list" data-find-results></ul>
  </div>

  <div data-find-fallback>
    <p class="annotation">
      Filtering needs JavaScript. Without it, every facet value has its own page — pick one and the list is the same:
    </p>

    <ul class="provider-list">
      {
        facets.map((facet) => (
          <li>
            <a href={`/${facet.id}/`}>{facet.label}</a>
            <p>{facet.values.filter((value) => value.count > 0).map((value) => value.label).join(' · ')}</p>
          </li>
        ))
      }
    </ul>

    <h2>Every record</h2>
    <ProviderList providers={providers} />
  </div>

  <script>
    import '../scripts/find.ts';
  </script>
</Base>
