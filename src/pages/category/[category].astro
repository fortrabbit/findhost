---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProviderRegister from '../../components/ProviderRegister.astro';
import { loadFacets } from '../../lib/facets';

/*
 * The category page is the facet value page with an explainer on the front. It
 * has its own route rather than falling out of /[facet]/[value] because the
 * written introduction is what makes a category more than a filter — everything
 * below it is the same register every other value page shows.
 */
export async function getStaticPaths() {
  const taxonomy = await getCollection('taxonomy');
  const category = taxonomy.find((facet) => facet.data.id === 'category');
  const { facets, providers } = await loadFacets();
  const explainers = await getCollection('categories');

  return (category?.data.values ?? [])
    .map((value) => ({
      params: { category: value.id },
      props: {
        id: value.id,
        label: value.label,
        explainer: explainers.find((entry) => entry.id === value.id),
        facets,
        matches: providers.filter((provider) => provider.facets.category === value.id),
      },
    }))
    .filter((route) => route.props.matches.length > 0);
}

const { id, label, explainer, facets, matches } = Astro.props;
const Explainer = explainer ? (await render(explainer)).Content : null;
---

<Base
  title={`${label} — FindHost`}
  description={explainer?.data.description ?? `Every ${label.toLowerCase()} provider in the dataset.`}
  ai={explainer?.data.ai}
>
  {
    explainer?.data.figure && (
      <p
        class="figure-band full-bleed"
        style={`background:${explainer.data.figure.color};color:${explainer.data.figure.textColor}`}
      >
        <span aria-hidden="true">{explainer.data.figure.emoji}</span> {explainer.data.figure.text}
      </p>
    )
  }

  <h1>{label}</h1>

  {Explainer && <Explainer />}

  <p class="annotation">
    A primary category is one field of many — several of these also offer what other categories describe.
  </p>

  <ProviderRegister providers={matches} facets={facets} seed={{ facet: 'category', value: id }} />
</Base>
