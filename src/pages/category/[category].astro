---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProviderList from '../../components/ProviderList.astro';
import { loadProviders } from '../../lib/providers';

// The category page is the guide page: the explainer opens it, the records it
// describes are listed directly beneath.
export async function getStaticPaths() {
  const taxonomy = await getCollection('taxonomy');
  const category = taxonomy.find((facet) => facet.data.id === 'category');
  const providers = await loadProviders();
  const explainers = await getCollection('categories');

  return (category?.data.values ?? [])
    .map((value) => ({
      params: { category: value.id },
      props: {
        label: value.label,
        explainer: explainers.find((entry) => entry.id === value.id),
        matches: providers
          .filter((provider) => provider.data.category === value.id)
          .map((provider) => ({
            id: provider.id,
            name: provider.data.name,
            description: provider.data.description,
            publishedByUs: provider.data.publishedByUs,
          }))
          .sort((a, b) => a.name.localeCompare(b.name, 'en')),
      },
    }))
    .filter((route) => route.props.matches.length > 0);
}

const { label, explainer, matches } = Astro.props;
const Explainer = explainer ? (await render(explainer)).Content : null;
---

<Base
  title={`${label} — FindHost`}
  description={explainer?.data.description ?? `Every ${label.toLowerCase()} provider in the dataset.`}
  ai={explainer?.data.ai}
>
  {
    explainer?.data.figure && (
      <p
        class="figure-band full-bleed"
        style={`background:${explainer.data.figure.color};color:${explainer.data.figure.textColor}`}
      >
        <span aria-hidden="true">{explainer.data.figure.emoji}</span> {explainer.data.figure.text}
      </p>
    )
  }

  <h1>{label}</h1>

  {Explainer && <Explainer />}

  <h2>{matches.length === 1 ? '1 provider' : `${matches.length} providers`}</h2>
  <p class="annotation">
    Sorted alphabetically. A primary category is one field of many — several of these also offer what other categories
    describe.
  </p>

  <ProviderList providers={matches} />
</Base>
