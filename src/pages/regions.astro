---
import Base from '../layouts/Base.astro';
import WorldMap from '../components/WorldMap.astro';
import { countryPoints } from '../lib/map';
import { loadProviders } from '../lib/providers';
import { fieldOf, slugOf } from '../lib/fields';
import { facetCardPath } from '../lib/og';

const providers = await loadProviders();

const withRegions = providers.filter((provider) => provider.data.regions?.length);
const regions = withRegions.flatMap((provider) => provider.data.regions ?? []);

/*
 * This is the region index, and the only one. A facet index listing the same
 * countries as a column of text was the same page with the map taken out.
 * Each country leads to its own page rather than to an anchor further down
 * this one, so the list exists once.
 */
const regionField = fieldOf.get('regions')!;

const byCountry = [...new Set(regions)]
  .filter((code) => countryPoints[code])
  .map((code) => ({
    code,
    slug: slugOf(regionField, { id: code, label: countryPoints[code]!.label }),
    label: countryPoints[code]!.label,
    count: withRegions.filter((provider) => provider.data.regions?.includes(code)).length,
  }))
  .sort((a, b) => a.label.localeCompare(b.label, 'en'));

const unplaced = [...new Set(regions)].filter((code) => !countryPoints[code]);

/*
 * `regions: null` means the question does not apply — a panel that provisions
 * onto your own cloud account operates none of its own. Counting those as
 * missing would overstate the gap and understate the dataset.
 */
const notApplicable = providers.filter((provider) => provider.data.regions === null).length;
const unknown = providers.length - withRegions.length - notApplicable;
---

<Base
  title="Where providers operate — FindHost"
  description="A map of the countries each hosting provider runs in, and a page for every one of them."
  image={facetCardPath('regions')}
  imageAlt="A FindHost card: where hosting providers operate."
>
  <h1>Find a host near you</h1>

  <WorldMap
    regions={regions}
    weighted
    full
    caption={false}
    linkPattern="/regions/{slug}/"
    label="Countries the providers in this dataset operate in"
  />

  <ul class="country-index">
    {
      byCountry.map((country) => (
        <li>
          <a href={`/regions/${country.slug}/`}>{country.label}</a>
          <span class="entry-count">{country.count}</span>
        </li>
      ))
    }
  </ul>

  <p class="annotation">
    {withRegions.length} of {providers.length} records say where they operate.
    {unknown > 0 && ` ${unknown} do not record it yet.`}
    {
      notApplicable > 0 &&
        ` A further ${notApplicable} run on infrastructure you bring yourself, so they have no regions of their own to record.`
    }
    {unplaced.length > 0 && ` No coordinates yet for ${unplaced.join(', ')}.`}
  </p>
</Base>
