---
import Base from '../layouts/Base.astro';
import WorldMap from '../components/WorldMap.astro';
import { loadProviders } from '../lib/providers';
import { fieldOf, slugOf } from '../lib/fields';
import { getCollection, render } from 'astro:content';
import { facetCardPath } from '../lib/og';
import { licenceUrl, organization } from '../lib/seo';

const providers = await loadProviders();

const withRegions = providers.filter((provider) => provider.data.regions?.length);
const regions = withRegions.flatMap((provider) => provider.data.regions ?? []);

/*
 * This is the region index, and the only one. A facet index listing the same
 * countries as a column of text was the same page with the map taken out.
 * Each country leads to its own page rather than to an anchor further down
 * this one, so the list exists once.
 *
 * Every country a record names is listed, from the dictionary rather than from
 * the map's coordinates: a country the map cannot place yet still has its page,
 * and this is the page that links to it.
 */
const regionField = fieldOf.get('regions')!;
const valueOf = new Map(regionField.values.map((value) => [value.id, value]));

const byCountry = [...new Set(regions)]
  .map((code) => valueOf.get(code)!)
  .map((value) => ({
    code: value.id,
    slug: slugOf(regionField, value),
    label: value.label,
    count: withRegions.filter((provider) => provider.data.regions?.includes(value.id)).length,
  }))
  .sort((a, b) => a.label.localeCompare(b.label, 'en'));

/* The same note the facet's card reads, so the two cannot name this page differently. */
const note = (await getCollection('notes')).find((entry) => entry.id === 'regions');
const Note = note ? (await render(note)).Content : null;
const title = note?.data.title ?? regionField.label;
const description = note?.data.description ?? `Every value recorded for ${regionField.label.toLowerCase()}.`;

/*
 * `regions: null` means the question does not apply — a panel that provisions
 * onto your own cloud account operates none of its own. Counting those as
 * missing would overstate the gap and understate the dataset.
 */
const notApplicable = providers.filter((provider) => provider.data.regions === null).length;
const unknown = providers.length - withRegions.length - notApplicable;

const origin = Astro.site?.origin ?? '';
---

<Base
  title={`${title} — FindHost`}
  description={description}
  markdown="/regions/index.md"
  image={facetCardPath('regions')}
  imageAlt="A FindHost card: where hosting providers operate."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      url: `${origin}/regions/`,
      name: title,
      inLanguage: 'en',
      publisher: organization(origin),
      license: licenceUrl,
      /* The same shape the other facet indexes carry: the countries, each leading to its own page. */
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: byCountry.length,
        itemListOrder: 'https://schema.org/ItemListOrderAscending',
        itemListElement: byCountry.map((country, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: `${origin}/regions/${country.slug}/`,
          name: country.label,
        })),
      },
    },
  ]}
>
  <h1>{title}</h1>

  {Note && <Note />}

  <WorldMap
    regions={regions}
    weighted
    full
    caption={false}
    linkPattern="/regions/{slug}/"
    label="Countries the providers in this dataset operate in"
  />

  <ul class="country-index">
    {
      byCountry.map((country) => (
        <li>
          <a href={`/regions/${country.slug}/`}>{country.label}</a>
          <span class="entry-count">{country.count}</span>
        </li>
      ))
    }
  </ul>

  <p class="annotation">
    {withRegions.length} of {providers.length} records say where they operate.
    {unknown > 0 && ` ${unknown} do not record it yet.`}
    {
      notApplicable > 0 &&
        ` A further ${notApplicable} run on infrastructure you bring yourself, so they have no regions of their own to record.`
    }
  </p>
</Base>
