---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { organization, valueTitle } from '../../lib/seo';
import ProviderRegister from '../../components/ProviderRegister.astro';
import PageFigure from '../../components/PageFigure.astro';
import { facetIndex, facetRoutes, loadFacets } from '../../lib/facets';
import { fieldOf, subjectOf } from '../../lib/fields';
import { summarise } from '../../lib/summarise';
import { valueCardPath } from '../../lib/og';

/*
 * One static page per facet value in use. These are what a crawler follows and
 * what a reader without JavaScript gets: the register narrowed to one value,
 * with the narrowing in the path rather than in a query string.
 *
 * It carries no filters. Ticking a second value here would contradict the URL,
 * the heading and the prose all at once, so the page links into the register
 * with this value already set and lets combining happen there.
 */
export async function getStaticPaths() {
  return facetRoutes();
}

const { facet, value, matches } = Astro.props;

const { facets } = await loadFacets();

/* Phrased in fields.yml, beside the field it describes — see subjectOf. */
const summary = summarise(matches, facets, facet.id, subjectOf(fieldOf.get(facet.field)!, value, matches.length));

/*
 * The count, what the records have in common and what is missing, in one
 * annotation. They were three stacked blocks of numbers, two of them opening
 * with the same total — read as a wall and skipped as one.
 *
 * One string, for the reason given in ProviderRegister.astro.
 */
const counted = [
  summary,
  facet.unknown > 0 &&
    `${facet.unknown} ${facet.unknown === 1 ? 'record does' : 'records do'} not record this field, and cannot appear here either way.`,
  facet.notApplicable > 0 && `For ${facet.notApplicable} the question does not apply.`,
]
  .filter(Boolean)
  .join(' ');

/*
 * A written explainer exists for some values and not others, which is the
 * intended state: filler for all of them would be thin content by definition.
 * Its title heads the browser tab only — the heading stays the value's own
 * label, so the page and the filter that leads to it say the same word.
 */
const origin = Astro.site?.origin ?? '';
const notes = await getCollection('notes');
const note = notes.find((entry) => entry.id === `${facet.id}/${value.id}`);
const Note = note ? (await render(note)).Content : null;
const figure = note?.data.figure;
---

<Base
  title={`${note?.data.title ?? valueTitle(facet.id, value.label)} — FindHost`}
  description={note?.data.description ?? summary.split('. ')[0].concat('.')}
  image={valueCardPath(facet.id, value.slug)}
  imageAlt={`A FindHost card: ${matches.length} providers recorded as ${value.label.toLowerCase()}.`}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: facet.label, item: `${origin}${facetIndex(facet.id)}` },
        { '@type': 'ListItem', position: 2, name: value.label },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: note?.data.title ?? valueTitle(facet.id, value.label),
      numberOfItems: matches.length,
      isPartOf: organization(origin),
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: matches.map((provider, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${origin}/${provider.id}/`,
        name: provider.name,
      })),
    },
  ]}
>
  {/* The parent, and only the parent — the register is the wordmark's job. */}
  <p class="crumb" data-pagefind-ignore><a href={facetIndex(facet.id)}>{facet.label}</a></p>

  <div class="page-head">
    <h1>{value.label}</h1>
    <a class="find-onward" data-pagefind-ignore href={`/?${facet.id}=${value.id}`}>Combine filters →</a>
  </div>

  <PageFigure figure={figure} />

  {Note && <Note />}

  {/* What we know about the set, after what a person wrote about it. */}
  <p class="annotation">{counted}</p>

  <ProviderRegister
    providers={matches}
    facets={facets}
    seed={{ facet: facet.id, value: value.id, label: value.label }}
  />
</Base>

{/* For the extended/slim toggle only. This page ships no filters — its URL is the narrowing. */}
<script>
  import '../../scripts/find.ts';
</script>
