---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { loadFacets } from '../../lib/facets';

export async function getStaticPaths() {
  const { facets } = await loadFacets();

  /*
   * `regions` has no index here. /map/ is the region index and lists the same
   * countries with the same counts — this page was that page with the map taken
   * out.
   */
  return facets
    .filter((facet) => facet.id !== 'regions')
    .map((facet) => ({ params: { facet: facet.id }, props: { facet } }));
}

const { facet } = Astro.props;
const inUse = facet.values.filter((value) => value.count > 0);
const unused = facet.values.filter((value) => value.count === 0);

/* One string, for the reason given in providers/index.astro. */
const annotation = [
  `${inUse.length} ${inUse.length === 1 ? 'value' : 'values'} in use.`,
  facet.unknown > 0 && `${facet.unknown} ${facet.unknown === 1 ? 'record does' : 'records do'} not record this field.`,
  facet.notApplicable > 0 &&
    `For a further ${facet.notApplicable} the question does not apply, so there is nothing to record.`,
]
  .filter(Boolean)
  .join(' ');

/*
 * A facet may have a written introduction of its own, at notes/<facet>.md, and
 * each of its values may have one at notes/<facet>/<value>.md. Where a value's
 * note opens with a lead, the list below carries it as a one-line gloss.
 */
const notes = await getCollection('notes');
const note = notes.find((entry) => entry.id === facet.id);
const leadOf = new Map(
  notes
    .filter((entry) => entry.id.startsWith(`${facet.id}/`) && entry.data.lead)
    .map((entry) => [entry.id.slice(facet.id.length + 1), entry.data.lead]),
);
const Note = note ? (await render(note)).Content : null;
const figure = note?.data.figure;
---

<Base
  title={`${note?.data.title ?? facet.label} — FindHost`}
  description={note?.data.description ?? `Every value recorded for ${facet.label.toLowerCase()}.`}
>
  {
    figure && (
      <p class="figure-band full-bleed" style={`background:${figure.color};color:${figure.textColor}`}>
        <span aria-hidden="true">{figure.emoji}</span> {figure.text}
      </p>
    )
  }

  <h1>{note?.data.title ?? facet.label}</h1>

  {note?.data.lead && <p class="lead">{note.data.lead}</p>}

  {Note && <Note />}

  <p class="annotation">{annotation}</p>

  <ul class="stack-list">
    {
      inUse.map((value) => (
        <li>
          <a href={`/${facet.id}/${value.id}/`}>{value.label}</a>
          <span>
            {value.count}
            <!-- {value.count === 1 ? 'record' : 'records'} -->
          </span>
          {leadOf.has(value.id) && <p>{leadOf.get(value.id)}</p>}
        </li>
      ))
    }
  </ul>

  {
    unused.length > 0 && (
      <p class="annotation">
        Defined but unused so far: {unused.map((value) => value.label).join(', ')}. A value with no records is a gap in
        our coverage, not a statement about the market.
      </p>
    )
  }
</Base>
